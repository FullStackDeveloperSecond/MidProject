@model MidProject.Models.ViewModels.Notifications.NotificationFormViewModel
@{ ViewData["Title"] = "編輯通知"; }
@section Styles { <link rel="stylesheet" href="~/css/notifications-admin.css" asp-append-version="true" /> }

<div class="notification-admin">
    <div class="mb-3"><h1 class="h2">編輯通知 #@Model.NotificationID</h1><p class="text-muted">儲存時會重新驗證全部欄位與通知狀態</p></div>
    <div class="card">
        <div class="card-header fw-semibold">通知資料</div>
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.NotificationID" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="NotificationID" type="hidden" />
                <input asp-for="RowVersion" type="hidden" />
                <partial name="_FormFields" model="Model" />
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">儲存</button>
                    <a asp-action="Details" asp-route-id="@Model.NotificationID" class="btn btn-secondary">返回</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
