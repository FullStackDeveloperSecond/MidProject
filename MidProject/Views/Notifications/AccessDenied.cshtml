@model MidProject.Models.ViewModels.Notifications.NotificationAccessDeniedViewModel
@{ ViewData["Title"] = "通知管理"; }
@section Styles { <link rel="stylesheet" href="~/css/notifications-admin.css" asp-append-version="true" /> }

<div class="notification-admin">
    <div class="card border-danger">
        <div class="card-header bg-danger text-white">無法執行</div>
        <div class="card-body">
            <div class="alert alert-danger mb-3" role="alert">@Model.Message</div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">返回</a>
        </div>
    </div>
</div>
