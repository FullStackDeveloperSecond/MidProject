@model MidProject.Models.ViewModels.Notifications.NotificationDetailsViewModel
@{ ViewData["Title"] = $"通知 #{Model.NotificationID}"; }
@section Styles { <link rel="stylesheet" href="~/css/notifications-admin.css" asp-append-version="true" /> }

<div class="notification-admin">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h1 class="h2">通知 #@Model.NotificationID</h1><p class="text-muted mb-0">通知完整資料</p></div>
        <div class="d-flex gap-2">
            @if (Model.CanMutate)
            {
                <a asp-action="Edit" asp-route-id="@Model.NotificationID" class="btn btn-warning">編輯</a>
                <a asp-action="Delete" asp-route-id="@Model.NotificationID" class="btn btn-danger">刪除</a>
            }
            <a asp-action="Index" class="btn btn-secondary">返回</a>
        </div>
    </div>
    @if (TempData["NotificationSuccess"] is string success) { <div class="alert alert-success">@success</div> }
    <div class="card">
        <div class="card-header d-flex justify-content-between">
            <span class="fw-semibold">@Model.Title</span>
            @if (Model.IsDeleted) { <span class="badge bg-danger">已刪除</span> }
            else if (Model.IsSent) { <span class="badge bg-success">已發送</span> }
            else { <span class="badge bg-warning text-dark">未發送</span> }
        </div>
        <div class="card-body">
            <dl class="row notification-details">
                <dt class="col-sm-3">NotificationID</dt><dd class="col-sm-9">@Model.NotificationID</dd>
                <dt class="col-sm-3">通知類型</dt><dd class="col-sm-9">@Model.NotificationType</dd>
                <dt class="col-sm-3">對象摘要</dt><dd class="col-sm-9">@Model.AudienceSummary</dd>
                <dt class="col-sm-3">MemberID</dt>
                <dd class="col-sm-9">
                    @if (Model.MemberID.HasValue)
                    {
                        <a asp-controller="AdminMembers" asp-action="Edit" asp-route-id="@Model.MemberID.Value">@Model.MemberID</a>
                    }
                    else
                    {
                        @:—
                    }
                </dd>
                <dt class="col-sm-3">TargetRole</dt><dd class="col-sm-9">@(Model.TargetRole ?? "—")</dd>
                <dt class="col-sm-3">TargetStatus</dt><dd class="col-sm-9">@(Model.TargetStatus ?? "—")</dd>
                <dt class="col-sm-3">TargetLevelID</dt><dd class="col-sm-9">@(Model.TargetLevelID?.ToString() ?? "—")</dd>
                <dt class="col-sm-3">內容</dt><dd class="col-sm-9 notification-content">@Model.Content</dd>
                <dt class="col-sm-3">ScheduledAt</dt><dd class="col-sm-9">@Model.ScheduledAt.ToString("yyyy/MM/dd HH:mm")</dd>
                <dt class="col-sm-3">SentAt</dt><dd class="col-sm-9">@(Model.SentAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</dd>
                <dt class="col-sm-3">CreatedAt</dt><dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</dd>
                <dt class="col-sm-3">CreatedBy</dt><dd class="col-sm-9">@Model.CreatedBy</dd>
                <dt class="col-sm-3">DeletedAt</dt><dd class="col-sm-9">@(Model.DeletedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</dd>
                <dt class="col-sm-3">DeletedBy</dt><dd class="col-sm-9">@(Model.DeletedBy?.ToString() ?? "—")</dd>
                <dt class="col-sm-3">Report 來源</dt>
                <dd class="col-sm-9">
                    @if (Model.SourceReportID.HasValue)
                    {
                        <a asp-controller="Reports" asp-action="Details" asp-route-id="@Model.SourceReportID.Value">
                            Report @Model.SourceReportID／@Model.SourceReportOutcome
                        </a>
                    }
                    else
                    {
                        @:—
                    }
                </dd>
            </dl>
        </div>
    </div>
</div>
