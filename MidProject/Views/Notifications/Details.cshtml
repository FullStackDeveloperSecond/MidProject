@model MidProject.Models.ViewModels.Notifications.NotificationDetailsViewModel
@{
    ViewData["Title"] = $"通知 #{Model.NotificationID}";
    var typeLabel = Model.NotificationType switch
    {
        "Personal" => "個人通知",
        "Condition" => "條件式通知",
        _ => Model.NotificationType
    };
    var statusLabel = Model.IsDeleted ? "已刪除" : Model.IsSent ? "已發送" : "待發送";
    var statusClass = Model.IsDeleted ? "danger" : Model.IsSent ? "success" : "warning";
    var statusIcon = Model.IsDeleted ? "fa-trash" : Model.IsSent ? "fa-check-circle" : "fa-clock";
}
@section Styles {
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notifications-admin.css" asp-append-version="true" />
}

<div class="notification-admin">
    <div class="detail-header-bar">
        <a class="btn btn-outline-secondary js-back-btn" href="@Url.Action("Index")">
            <i class="fas fa-arrow-left me-1"></i>返回通知列表
        </a>
        <div class="detail-crumb"><a asp-action="Index">通知管理</a> / 通知 #@Model.NotificationID</div>
    </div>

    @if (TempData["NotificationSuccess"] is string success)
    {
        <div class="alert alert-success notification-detail-alert" role="status">
            <i class="fas fa-check-circle me-2"></i>@success
        </div>
    }

    <section class="notification-detail-hero" aria-labelledby="notification-title">
        <div class="notification-detail-hero-copy">
            <div class="notification-detail-eyebrow">
                <span class="ds-badge ds-badge-primary">@typeLabel</span>
                <span class="ds-badge ds-badge-@statusClass">
                    <i class="fas @statusIcon me-1"></i>@statusLabel
                </span>
                <span class="notification-detail-id">通知 #@Model.NotificationID</span>
            </div>
            <h1 id="notification-title">@Model.Title</h1>
            <p>
                <i class="fas fa-users" aria-hidden="true"></i>
                @Model.AudienceSummary
            </p>
        </div>
        <div class="notification-detail-actions">
            @if (Model.CanMutate)
            {
                <a asp-action="Edit" asp-route-id="@Model.NotificationID" class="btn btn-outline-secondary">
                    <i class="fas fa-edit me-1"></i>編輯通知
                </a>
                <a asp-action="Delete" asp-route-id="@Model.NotificationID" class="btn btn-danger">
                    <i class="fas fa-trash me-1"></i>刪除
                </a>
            }
        </div>
    </section>

    <div class="notification-detail-grid">
        <div class="notification-detail-primary">
            <section class="notification-detail-card" aria-labelledby="content-heading">
                <div class="notification-detail-card-heading">
                    <span class="notification-detail-section-icon notification-detail-section-icon-primary">
                        <i class="fas fa-bell"></i>
                    </span>
                    <div>
                        <h2 id="content-heading">通知內容</h2>
                        <p>實際傳送給通知對象的訊息</p>
                    </div>
                </div>
                <div class="notification-detail-message">@Model.Content</div>
            </section>

            <section class="notification-detail-card" aria-labelledby="audience-heading">
                <div class="notification-detail-card-heading">
                    <span class="notification-detail-section-icon notification-detail-section-icon-purple">
                        <i class="fas fa-users"></i>
                    </span>
                    <div>
                        <h2 id="audience-heading">通知對象</h2>
                        <p>@Model.AudienceSummary</p>
                    </div>
                </div>
                <div class="notification-audience-detail">
                    @if (Model.MemberID.HasValue)
                    {
                        <a class="notification-target-chip" asp-controller="AdminMembers" asp-action="Edit" asp-route-id="@Model.MemberID.Value">
                            <i class="fas fa-user"></i>
                            會員 #@Model.MemberID
                            <i class="fas fa-external-link-alt"></i>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.TargetRole))
                    {
                        <span class="notification-target-chip"><i class="fas fa-user-shield"></i>角色：@Model.TargetRole</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.TargetStatus))
                    {
                        <span class="notification-target-chip"><i class="fas fa-user-check"></i>狀態：@Model.TargetStatus</span>
                    }
                    @if (Model.TargetLevelID.HasValue)
                    {
                        <span class="notification-target-chip"><i class="fas fa-layer-group"></i>等級 #@Model.TargetLevelID</span>
                    }
                </div>
            </section>

            <details class="notification-record-details">
                <summary>
                    <span><i class="fas fa-info-circle me-2"></i>系統紀錄與來源</span>
                    <i class="fas fa-chevron-down notification-record-chevron"></i>
                </summary>
                <div class="notification-record-grid">
                    <div><span>通知編號</span><strong>#@Model.NotificationID</strong></div>
                    <div><span>建立管理員</span><strong>#@Model.CreatedBy</strong></div>
                    @if (Model.SourceReportID.HasValue)
                    {
                        <div class="notification-record-wide">
                            <span>檢舉來源</span>
                            <a asp-controller="Reports" asp-action="Details" asp-route-id="@Model.SourceReportID.Value">
                                檢舉 #@Model.SourceReportID · @Model.SourceReportOutcome
                                <i class="fas fa-external-link-alt ms-1"></i>
                            </a>
                        </div>
                    }
                    @if (Model.DeletedBy.HasValue)
                    {
                        <div><span>刪除管理員</span><strong>#@Model.DeletedBy</strong></div>
                    }
                </div>
            </details>
        </div>

        <aside class="notification-detail-card notification-timeline-card" aria-labelledby="timeline-heading">
            <div class="notification-detail-card-heading">
                <span class="notification-detail-section-icon notification-detail-section-icon-warning">
                    <i class="fas fa-history"></i>
                </span>
                <div>
                    <h2 id="timeline-heading">通知時程</h2>
                    <p>建立、排程與發送狀態</p>
                </div>
            </div>
            <ol class="notification-timeline">
                <li class="is-complete">
                    <span class="notification-timeline-marker"><i class="fas fa-plus"></i></span>
                    <div>
                        <strong>建立通知</strong>
                        <time datetime="@Model.CreatedAt.ToString("O")">@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</time>
                    </div>
                </li>
                <li class="is-complete">
                    <span class="notification-timeline-marker"><i class="fas fa-calendar-alt"></i></span>
                    <div>
                        <strong>排程時間</strong>
                        <time datetime="@Model.ScheduledAt.ToString("O")">@Model.ScheduledAt.ToString("yyyy/MM/dd HH:mm")</time>
                    </div>
                </li>
                @if (Model.IsSent && Model.SentAt.HasValue)
                {
                    <li class="is-complete">
                        <span class="notification-timeline-marker"><i class="fas fa-paper-plane"></i></span>
                        <div>
                            <strong>已完成發送</strong>
                            <time datetime="@Model.SentAt.Value.ToString("O")">@Model.SentAt.Value.ToString("yyyy/MM/dd HH:mm")</time>
                        </div>
                    </li>
                }
                else if (!Model.IsDeleted)
                {
                    <li>
                        <span class="notification-timeline-marker"><i class="fas fa-clock"></i></span>
                        <div><strong>等待發送</strong><span>到達排程時間後可執行發送</span></div>
                    </li>
                }
                @if (Model.IsDeleted && Model.DeletedAt.HasValue)
                {
                    <li class="is-danger">
                        <span class="notification-timeline-marker"><i class="fas fa-trash"></i></span>
                        <div>
                            <strong>已刪除</strong>
                            <time datetime="@Model.DeletedAt.Value.ToString("O")">@Model.DeletedAt.Value.ToString("yyyy/MM/dd HH:mm")</time>
                        </div>
                    </li>
                }
            </ol>
        </aside>
    </div>
</div>
