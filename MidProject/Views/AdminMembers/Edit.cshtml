@model Member
@{
    var reports = ViewBag.ApprovedReports as List<Report> ?? new List<Report>();
    var levelsSorted = ((IEnumerable<UserLevel>)ViewBag.Levels).OrderBy(l => l.MinExp).ToList();
    var levelIndex = levelsSorted.FindIndex(l => l.LevelID == Model.LevelID);
    var levelNumber = levelIndex + 1;
    int? nextThreshold = (levelIndex >= 0 && levelIndex < levelsSorted.Count - 1) ? levelsSorted[levelIndex + 1].MinExp : (int?)null;

    (string Label, string BadgeClass, string Style, string Emoji) StatusInfo(string status) => status switch
    {
        "Normal" => ("正常", "bg-success", "", "✅"),
        "Warning" => ("警告", "bg-warning text-dark", "", "⚠️"),
        "Muted" => ("禁言", "text-white", "background-color:#fd7e14;", "🔇"),
        "Suspended" => ("停權", "bg-danger", "", "⛔"),
        "Deleted" => ("刪除", "bg-secondary", "", "🗑️"),
        _ => (status, "bg-secondary", "", "")
    };
    var currentStatus = StatusInfo(Model.Status);
    var avatarUrl = Model.AvatarImage?.ImageURL;
    var defaultAvatar = "/uploads/MemberAvatar/avatar24-01.jpg";
    var isSuspended = Model.Status == "Suspended";
    var removeAvatarRequested = ViewBag.RemoveAvatarRequested is true;
    var unlockAccountRequested = ViewBag.UnlockAccountRequested is true;
}

<style>
    .violation-record-link:hover {
        background-color: rgba(0, 0, 0, 0.04);
    }
</style>
<div class="d-flex justify-content-between align-items-center">
    <h2>會員詳細 / 編輯</h2>
    <form asp-action="RecalculateEscalation" method="post">
        <input type="hidden" name="returnToMemberId" value="@Model.MemberID" />
        <button type="submit" class="btn btn-outline-secondary btn-sm">🔄 重新整理</button>
    </form>
</div>

@if (TempData["EscalationResult"] != null)
{
    <div class="alert alert-info alert-dismissible fade show">
        @TempData["EscalationResult"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.IsLocked)
{
    <div class="alert alert-secondary d-flex justify-content-between align-items-center">
        <span>🔒 此帳號因密碼輸入錯誤已達 3 次被鎖定（累計失敗 @Model.FailedLoginCount 次），無法登入。</span>
        <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#unlockAccountModal">
            🔓 解除鎖定
        </button>
    </div>
}
@if (isSuspended)
{
    <div class="alert alert-secondary d-flex justify-content-between align-items-center">
        <span>⛔ 此會員目前為停權狀態，欄位已鎖定無法編輯。</span>
        <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#liftSuspensionModal">
            🔓 解除停權
        </button>
    </div>
}

<form asp-action="Edit" method="post" id="editForm" class="@(isSuspended ? "opacity-50" : "")">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger"></div>
    }
    <div class="row">
        <div class="col-md-4">
            <div class="card p-3 mb-3">
                <input type="hidden" asp-for="MemberID" />
                <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)" />
                <input type="hidden" name="UnlockAccountRequested" id="unlockAccountRequestedInput" value="@(unlockAccountRequested ? "true" : "false")" />
                <input type="hidden" name="UnlockReason" id="unlockReasonInput" value="@ViewBag.UnlockReason" />

                <div class="text-center mb-3">
                    <img id="avatarPreviewImg" src="@(avatarUrl ?? defaultAvatar)" width="100" height="100" class="rounded-circle" />
                    <div class="mt-2">
                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#avatarModal" disabled="@isSuspended">
                            🗑️ 移除照片
                        </button>
                    </div>
                    <input type="hidden" name="RemoveAvatarRequested" id="removeAvatarRequestedInput" value="@(removeAvatarRequested ? "true" : "false")" />
                    <input type="hidden" name="AvatarRemovalReason" id="avatarRemovalReasonInput" value="@ViewBag.AvatarRemovalReason" />
                </div>
                <p><strong>等級：</strong> LV@(levelNumber) @Model.UserLevel?.LevelName</p>
                <p><strong>經驗值：</strong> @Model.Experience@(nextThreshold.HasValue ? $" / {nextThreshold} EXP" : " (滿級)")</p>
                <div class="mb-2">
                    <strong>點數：</strong> <span id="pointsDisplay">@Model.Points</span>
                    <button type="button" class="btn btn-sm btn-outline-primary ms-1" data-bs-toggle="modal" data-bs-target="#pointsModal" disabled="@isSuspended">
                        ✏️ 調整點數
                    </button>
                    <input type="hidden" name="points" id="pointsMainInput" data-original-points="@ViewBag.OriginalPoints" value="@Model.Points" />
                    <input type="hidden" name="PointsChangeReason" id="pointsChangeReasonInput" value="@ViewBag.PointsChangeReason" />
                </div>
                <p>
                    <strong>目前狀態：</strong>
                    <a href="#" data-bs-toggle="modal" data-bs-target="#violationModal" class="text-decoration-none">
                        <span class="badge @currentStatus.BadgeClass" style="@currentStatus.Style">@currentStatus.Emoji @currentStatus.Label</span>
                    </a>
                </p>
                <p><strong>註冊時間：</strong> @Model.CreatedAt</p>
            </div>

            <div class="card p-3">
                @* 這裡的 (@reports.Count) 是下面清單目前實際列出的筆數（即時查 Reports 表），
                   跟下方「處罰期限」區塊的「檢舉累積次數」（Model.WarningCount，懲處排程上次套用時的檢查點次數）
                   是兩個不同用途的數字：一個是「現在有幾筆」，一個是「上次懲處依據的是幾筆」，
                   排程還沒跑到之前兩者可能有落差，是預期行為。 *@
                <h5>⚠️ 違規受理紀錄 (@reports.Count)</h5>
                <div style="max-height: 300px; overflow-y: auto;">
                    @foreach (var r in reports)
                    {
                        <a asp-controller="Reports" asp-action="Details" asp-route-id="@r.ReportID"
                           class="d-block border-bottom py-2 text-decoration-none text-body violation-record-link">
                            <small class="text-muted">@r.CreatedAt</small><br />
                            <strong>原因：</strong> @r.Reason <br />
                            <small class="text-secondary">備註：@r.AdminNote</small>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card p-3">
                <div class="mb-3">
                    <label class="form-label">帳號</label>
                    <input asp-for="UserName" class="form-control bg-light" readonly tabindex="-1" />
                    <span class="form-text text-muted">帳號為登入識別，建立後不可變更。</span>
                </div>
                <div class="mb-3">
                    <label class="form-label">名稱</label>
                    <div class="input-group">
                        <input type="text" name="NickName" id="nicknameDisplayInput" data-original-nickname="@ViewBag.OriginalNickName" class="form-control bg-light" value="@Model.NickName" readonly tabindex="-1" />
                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#nicknameModal" disabled="@isSuspended">
                            ✏️ 變更名稱
                        </button>
                    </div>
                    <input type="hidden" name="NicknameChangeReason" id="nicknameChangeReasonInput" value="@ViewBag.NicknameChangeReason" />
                </div>
                <div class="mb-3">
                    <label class="form-label">生日</label>
                    <input value="@(Model.Birthday?.ToString("yyyy-MM-dd") ?? "未設定")" class="form-control bg-light" readonly tabindex="-1" />
                </div>
                <div class="mb-3">
                    <label class="form-label">信箱</label>
                    <input value="@Model.Email" class="form-control bg-light" readonly tabindex="-1" />
                    <span class="form-text text-muted">信箱為登入識別之一，如需變更請洽會員本人確認身分。</span>
                </div>
                <div class="mb-3">
                    <label class="form-label">會員狀態</label>
                    <select asp-for="Status" class="form-select" id="statusSelect" data-original-status="@ViewBag.OriginalStatus" disabled="@isSuspended">
                        <option value="Normal">正常</option>
                        <option value="Warning">警告</option>
                        <option value="Muted">禁言</option>
                        <option value="Suspended">停權</option>
                    </select>
                </div>
                <div class="mb-3" id="statusChangeReasonGroup" style="display:none;">
                    <label class="form-label">狀態變更原因</label>
                    <input type="text" name="StatusChangeReason" id="statusChangeReasonInput" class="form-control" value="@ViewBag.StatusChangeReason" maxlength="200" required readonly="@isSuspended" />
                    <span class="form-text text-muted">變更會員狀態時必填，儲存後會自動附上時間戳記寫入下方管理員備註。</span>
                    @if (ViewData.ModelState["StatusChangeReason"]?.Errors.Count > 0)
                    {
                        <span class="text-danger d-block">@ViewData.ModelState["StatusChangeReason"]!.Errors.First().ErrorMessage</span>
                    }
                </div>

                @if (Model.Status != "Normal")
                {
                    <div class="mb-3">
                        <label class="form-label">處罰期限</label>
                        <p class="mb-1 small">檢舉累積次數：@(Model.WarningCount)次</p>
                        <p class="mb-1 small">懲罰開始時間：@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</p>
                        <p class="mb-1 small">懲罰結束時間：@(Model.PenaltyEndAt?.ToString("yyyy-MM-dd HH:mm") ?? "永久")</p>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">備註欄</label>
                    <textarea asp-for="AdminNote" class="form-control bg-light" rows="3" readonly tabindex="-1"></textarea>
                    <span class="form-text text-muted">管理員手動調整（改名稱／移除照片／調整點數／變更狀態／解除鎖定）會自動在備註欄加註時間與原因，此欄位僅供顯示、不可手動輸入。</span>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success" disabled="@isSuspended">💾 保存變更</button>
                    <a asp-action="Index" class="btn btn-secondary">❌ 取消</a>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- 名稱變更 Modal：僅先預覽到主表單，需按主表單的「保存變更」才會真正保存 -->
<div class="modal fade" id="nicknameModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">變更會員名稱</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">新名稱</label>
                    <input type="text" id="nicknameModalInput" class="form-control" value="@Model.NickName" maxlength="50" />
                </div>
                <div class="mb-3">
                    <label class="form-label">請填寫變更原因（例如：名稱不雅）</label>
                    <textarea id="nicknameModalReason" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="confirmNicknameChange">確認變更</button>
            </div>
        </div>
    </div>
</div>

<!-- 照片移除 Modal：僅先預覽到主表單，需按主表單的「保存變更」才會真正保存 -->
<div class="modal fade" id="avatarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">移除會員照片</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">移除後將改回預設照片。</p>
                <div class="mb-3">
                    <label class="form-label">請填寫移除原因（例如：照片不雅）</label>
                    <textarea id="avatarModalReason" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-danger" id="confirmAvatarRemoval">確認移除</button>
            </div>
        </div>
    </div>
</div>

<!-- 調整點數 Modal：僅先預覽到主表單，需按主表單的「保存變更」才會真正保存 -->
<div class="modal fade" id="pointsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">調整會員點數</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">舊點數</label>
                    <input type="text" class="form-control bg-light" value="@Model.Points" readonly tabindex="-1" />
                </div>
                <div class="mb-3">
                    <label class="form-label">新點數</label>
                    <div class="input-group">
                        <button type="button" class="btn btn-outline-secondary" id="newPointsMinus">-</button>
                        <input type="number" id="newPointsInput" class="form-control text-center" value="@Model.Points" min="0" />
                        <button type="button" class="btn btn-outline-secondary" id="newPointsPlus">+</button>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">請填寫調整原因（例如：活動獎勵）</label>
                    <textarea id="pointsModalReason" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="confirmPointsChange">確認調整</button>
            </div>
        </div>
    </div>
</div>

<!-- 解除帳號鎖定 Modal：原因選填，但仍需二次確認彈窗；僅先預覽到主表單，需按主表單的「保存變更」才會真正保存 -->
<div class="modal fade" id="unlockAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">解除帳號鎖定</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">解除後會員即可再次嘗試登入，登入失敗次數會歸零重新計算。</p>
                <div class="mb-3">
                    <label class="form-label">解除鎖定的原因（選填）</label>
                    <textarea id="unlockModalReason" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-warning" id="confirmUnlockAccount">確認解除</button>
            </div>
        </div>
    </div>
</div>

<!-- 解除停權 Modal：僅將欄位解鎖並帶入選擇的狀態/原因，實際保存仍需按主表單的「保存變更」 -->
<div class="modal fade" id="liftSuspensionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">🔓 解除停權</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">確認後會解鎖下方表單欄位，仍需按「保存變更」才會真正保存。</p>
                <div class="mb-3">
                    <label class="form-label">解除後的會員狀態</label>
                    <select id="liftNewStatus" class="form-select" required>
                        <option value="Normal">正常</option>
                        <option value="Warning">警告</option>
                        <option value="Muted">禁言</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">請填寫解除停權原因</label>
                    <textarea id="liftReason" class="form-control" rows="2" required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-warning" id="confirmLiftSuspension">確認，解鎖表單</button>
            </div>
        </div>
    </div>
</div>

<!-- 違規總覽 Modal -->
<div class="modal fade" id="violationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">⚠️ 違規總覽 / 懲處條件</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">依累積受理檢舉次數套用懲處：</p>
                <ol class="list-group list-group-numbered">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>⚠️ 警告</span>
                        <span class="text-muted small">累積 1 次受理檢舉</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>🔇 禁言 1 週</span>
                        <span class="text-muted small">累積 2 次受理檢舉</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>🔇 禁言 1 個月</span>
                        <span class="text-muted small">累積 3 次受理檢舉</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>⛔ 停權</span>
                        <span class="text-muted small">累積 4 次受理檢舉</span>
                    </li>
                </ol>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // 所有手動調整動作（改名稱／移除照片／調整點數／解除鎖定／變更狀態）都採「先預覽、後保存」的流程：
    // 彈窗確認只會把變更即時反映在主表單的欄位與下方「備註欄」預覽文字上，尚未真的寫進資料庫，
    // 必須再按主表單的「💾 保存變更」才會一次性套用所有已預覽的變更並真正保存。
    (function () {
        var adminNoteEl = document.querySelector('textarea[name="AdminNote"]');
        if (!adminNoteEl) return;

        var baseAdminNote = adminNoteEl.value; // 頁面載入當下、尚未套用任何預覽的真實內容
        var pendingNotes = { unlock: null, nickname: null, avatar: null, points: null, status: null };

        function pad(n) { return n < 10 ? '0' + n : '' + n; }
        function timestamp() {
            var d = new Date();
            return d.getFullYear() + '/' + (d.getMonth() + 1) + '/' + d.getDate() + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
        }

        function rebuildAdminNotePreview() {
            var lines = Object.keys(pendingNotes)
                .map(function (key) { return pendingNotes[key]; })
                .filter(Boolean);
            var combined = lines.join('\n');
            adminNoteEl.value = combined ? (baseAdminNote ? combined + '\n' + baseAdminNote : combined) : baseAdminNote;
        }

        // ---- 狀態變更 ----
        var statusSelect = document.getElementById('statusSelect');
        var reasonGroup = document.getElementById('statusChangeReasonGroup');
        var reasonInput = document.getElementById('statusChangeReasonInput');
        if (statusSelect && reasonGroup && reasonInput) {
            var originalStatus = statusSelect.getAttribute('data-original-status');
            var statusLabels = { Normal: '正常', Warning: '警告', Muted: '禁言', Suspended: '停權' };

            var updateStatusPreview = function () {
                var changed = statusSelect.value !== originalStatus;
                var reason = reasonInput.value.trim();
                if (changed && reason) {
                    var oldLabel = statusLabels[originalStatus] || originalStatus;
                    var newLabel = statusLabels[statusSelect.value] || statusSelect.value;
                    pendingNotes.status = timestamp() + ' 已將狀態從「' + oldLabel + '」變更為「' + newLabel + '」，原因：' + reason;
                } else {
                    pendingNotes.status = null;
                }
                rebuildAdminNotePreview();
            };

            window.toggleStatusChangeReasonGroup = function () {
                var changed = statusSelect.value !== originalStatus;
                reasonGroup.style.display = changed ? '' : 'none';
                // 瀏覽器的 HTML5 required 驗證只看欄位本身是否有 display:none，不會往上檢查父層，
                // 單靠外層 div 的 display:none 藏不住這個必填欄位，仍會擋住表單送出且不會顯示任何提示。
                // 因此改成跟著顯示狀態動態切換 required，欄位隱藏時就不參與驗證。
                reasonInput.required = changed;
                updateStatusPreview();
            };

            statusSelect.addEventListener('change', window.toggleStatusChangeReasonGroup);
            reasonInput.addEventListener('input', updateStatusPreview);
            window.toggleStatusChangeReasonGroup(); // 初始判斷（例如驗證失敗重新顯示時）
        }

        // ---- 改名稱 ----
        var nicknameDisplayInput = document.getElementById('nicknameDisplayInput');
        var nicknameChangeReasonInput = document.getElementById('nicknameChangeReasonInput');
        var confirmNicknameChange = document.getElementById('confirmNicknameChange');
        if (nicknameDisplayInput && nicknameChangeReasonInput && confirmNicknameChange) {
            var originalNickName = nicknameDisplayInput.getAttribute('data-original-nickname') || '';

            var recomputeNicknamePreview = function () {
                var current = nicknameDisplayInput.value.trim();
                var reason = nicknameChangeReasonInput.value.trim();
                pendingNotes.nickname = (current && current !== originalNickName && reason)
                    ? (timestamp() + ' 已將名稱從「' + originalNickName + '」變更為「' + current + '」，原因：' + reason)
                    : null;
                rebuildAdminNotePreview();
            };

            confirmNicknameChange.addEventListener('click', function () {
                var newName = document.getElementById('nicknameModalInput').value.trim();
                var reason = document.getElementById('nicknameModalReason').value.trim();
                if (!newName || !reason) {
                    alert('請填寫新名稱與變更原因');
                    return;
                }
                nicknameDisplayInput.value = newName;
                nicknameChangeReasonInput.value = reason;
                recomputeNicknamePreview();
                bootstrap.Modal.getInstance(document.getElementById('nicknameModal')).hide();
            });

            recomputeNicknamePreview(); // 初始判斷（例如驗證失敗重新顯示時）
        }

        // ---- 移除照片 ----
        var removeAvatarRequestedInput = document.getElementById('removeAvatarRequestedInput');
        var avatarRemovalReasonInput = document.getElementById('avatarRemovalReasonInput');
        var confirmAvatarRemoval = document.getElementById('confirmAvatarRemoval');
        if (removeAvatarRequestedInput && avatarRemovalReasonInput && confirmAvatarRemoval) {
            var recomputeAvatarPreview = function () {
                var requested = removeAvatarRequestedInput.value === 'true';
                var reason = avatarRemovalReasonInput.value.trim();
                pendingNotes.avatar = (requested && reason)
                    ? (timestamp() + ' 因' + reason + '，已移除照片')
                    : null;
                rebuildAdminNotePreview();
            };

            confirmAvatarRemoval.addEventListener('click', function () {
                var reason = document.getElementById('avatarModalReason').value.trim();
                if (!reason) {
                    alert('請填寫移除照片的原因');
                    return;
                }
                removeAvatarRequestedInput.value = 'true';
                avatarRemovalReasonInput.value = reason;
                recomputeAvatarPreview();
                var previewImg = document.getElementById('avatarPreviewImg');
                if (previewImg) previewImg.src = '@defaultAvatar';
                bootstrap.Modal.getInstance(document.getElementById('avatarModal')).hide();
            });

            recomputeAvatarPreview(); // 初始判斷（例如驗證失敗重新顯示時）
        }

        // ---- 調整點數 ----
        var pointsMainInput = document.getElementById('pointsMainInput');
        var pointsChangeReasonInput = document.getElementById('pointsChangeReasonInput');
        var pointsDisplay = document.getElementById('pointsDisplay');
        var newPointsInput = document.getElementById('newPointsInput');
        var confirmPointsChange = document.getElementById('confirmPointsChange');
        if (pointsMainInput && pointsChangeReasonInput && confirmPointsChange) {
            var originalPoints = parseInt(pointsMainInput.getAttribute('data-original-points'), 10) || 0;

            document.getElementById('newPointsMinus').addEventListener('click', function () {
                var value = parseInt(newPointsInput.value, 10) || 0;
                newPointsInput.value = Math.max(0, value - 1);
            });
            document.getElementById('newPointsPlus').addEventListener('click', function () {
                var value = parseInt(newPointsInput.value, 10) || 0;
                newPointsInput.value = value + 1;
            });

            var recomputePointsPreview = function () {
                var current = parseInt(pointsMainInput.value, 10);
                var reason = pointsChangeReasonInput.value.trim();
                pendingNotes.points = (!isNaN(current) && current !== originalPoints && reason)
                    ? (timestamp() + ' 已將點數從 ' + originalPoints + ' 調整為 ' + current + '，原因：' + reason)
                    : null;
                rebuildAdminNotePreview();
            };

            confirmPointsChange.addEventListener('click', function () {
                var newPoints = parseInt(newPointsInput.value, 10);
                var reason = document.getElementById('pointsModalReason').value.trim();
                if (isNaN(newPoints) || newPoints < 0 || !reason) {
                    alert('請填寫有效的點數與調整原因');
                    return;
                }
                pointsMainInput.value = newPoints;
                pointsChangeReasonInput.value = reason;
                pointsDisplay.textContent = newPoints;
                recomputePointsPreview();
                bootstrap.Modal.getInstance(document.getElementById('pointsModal')).hide();
            });

            recomputePointsPreview(); // 初始判斷（例如驗證失敗重新顯示時）
        }

        // ---- 解除帳號鎖定（原因選填）----
        var unlockAccountRequestedInput = document.getElementById('unlockAccountRequestedInput');
        var unlockReasonInput = document.getElementById('unlockReasonInput');
        var confirmUnlockAccount = document.getElementById('confirmUnlockAccount');
        if (unlockAccountRequestedInput && unlockReasonInput && confirmUnlockAccount) {
            var recomputeUnlockPreview = function () {
                var requested = unlockAccountRequestedInput.value === 'true';
                var reason = unlockReasonInput.value.trim();
                pendingNotes.unlock = requested
                    ? (reason ? (timestamp() + ' 已解除帳號鎖定，原因：' + reason) : (timestamp() + ' 已解除帳號鎖定'))
                    : null;
                rebuildAdminNotePreview();
            };

            confirmUnlockAccount.addEventListener('click', function () {
                var reason = document.getElementById('unlockModalReason').value.trim();
                unlockAccountRequestedInput.value = 'true';
                unlockReasonInput.value = reason;
                recomputeUnlockPreview();
                bootstrap.Modal.getInstance(document.getElementById('unlockAccountModal')).hide();
            });

            recomputeUnlockPreview(); // 初始判斷（例如驗證失敗重新顯示時）
        }

        // ---- 解除停權：解鎖表單欄位並帶入狀態/原因，仍需按「保存變更」才會真正保存 ----
        var confirmLiftSuspension = document.getElementById('confirmLiftSuspension');
        if (confirmLiftSuspension) {
            confirmLiftSuspension.addEventListener('click', function () {
                var newStatus = document.getElementById('liftNewStatus').value;
                var reason = document.getElementById('liftReason').value.trim();
                if (!reason) {
                    alert('請輸入解除停權原因');
                    return;
                }

                document.getElementById('editForm').classList.remove('opacity-50');
                ['statusSelect', 'statusChangeReasonInput'].forEach(function (id) {
                    document.getElementById(id).disabled = false;
                    document.getElementById(id).readOnly = false;
                });
                document.querySelector('[data-bs-target="#nicknameModal"]').disabled = false;
                document.querySelector('[data-bs-target="#avatarModal"]').disabled = false;
                document.querySelector('[data-bs-target="#pointsModal"]').disabled = false;
                document.querySelector('#editForm button[type="submit"]').disabled = false;

                document.getElementById('statusSelect').value = newStatus;
                document.getElementById('statusChangeReasonInput').value = reason;
                if (window.toggleStatusChangeReasonGroup) window.toggleStatusChangeReasonGroup();

                bootstrap.Modal.getInstance(document.getElementById('liftSuspensionModal')).hide();
            });
        }
    })();
</script>
}
