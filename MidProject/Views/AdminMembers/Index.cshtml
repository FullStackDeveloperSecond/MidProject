@model IEnumerable<Member>
@{
    var levelsSorted = ((IEnumerable<UserLevel>)ViewBag.Levels).OrderBy(l => l.MinExp).ToList();

    (string Label, string BadgeClass, string Style, string Emoji) StatusInfo(string status) => status switch
    {
        "Normal" => ("正常", "ds-badge-success", "", "✅"),
        "Warning" => ("警告", "ds-badge-warning", "", "⚠️"),
        "Muted" => ("禁言", "", "background-color:#fff0e0;color:#c2600c;", "🔇"),
        "Suspended" => ("停權", "ds-badge-danger", "", "⛔"),
        "Deleted" => ("刪除", "ds-badge-gray", "", "🗑️"),
        _ => (status, "ds-badge-gray", "", "")
    };
    var defaultAvatar = "/uploads/MemberAvatar/avatar24-01.jpg";
}

@section Styles {
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared-pagination.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/members-admin.css" asp-append-version="true" />
}

<div class="ds-page-header">
    <h1 class="ds-h2 mb-1">會員一覽</h1>
    <p>管理會員帳號、等級、點數與狀態</p>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <a href="@Url.Action("Index")"
           class="ds-stat-card ds-stat-card-sm d-block text-decoration-none text-reset @(!ViewBag.ShowAbnormal && !ViewBag.TodayOnly ? "member-stat-card-active" : "")">
            <div class="d-flex justify-content-between align-items-start">
                <div class="ds-stat-label ds-accent-primary">會員總數</div>
                <span class="ds-stat-icon ds-icon-primary"><i class="fas fa-users"></i></span>
            </div>
            <div class="ds-stat-value">@ViewBag.TotalMembers 名</div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Action("Index", new { todayOnly = !ViewBag.TodayOnly })"
           class="ds-stat-card ds-stat-card-sm d-block text-decoration-none text-reset @(ViewBag.TodayOnly ? "member-stat-card-active" : "")">
            <div class="d-flex justify-content-between align-items-start">
                <div class="ds-stat-label ds-accent-warning">今日新註冊</div>
                <span class="ds-stat-icon ds-icon-warning"><i class="fas fa-user-plus"></i></span>
            </div>
            <div class="ds-stat-value">@ViewBag.TodayRegistered 名</div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Action("Index", new { showAbnormal = !ViewBag.ShowAbnormal })"
           class="ds-stat-card ds-stat-card-sm d-block text-decoration-none text-reset @(ViewBag.ShowAbnormal ? "member-stat-card-danger" : "")">
            <div class="d-flex justify-content-between align-items-start">
                <div class="ds-stat-label ds-accent-danger">異常狀態會員</div>
                <span class="ds-stat-icon ds-icon-danger"><i class="fas fa-triangle-exclamation"></i></span>
            </div>
            <div class="ds-stat-value">@ViewBag.AbnormalCount 名</div>
        </a>
    </div>
</div>

<div class="ds-toolbar mb-3">
    <h6 class="ds-block-label">篩選條件</h6>
    <form method="get">
        <input type="hidden" name="showAbnormal" value="@ViewBag.ShowAbnormal.ToString().ToLower()" />
        <input type="hidden" name="todayOnly" value="@ViewBag.TodayOnly.ToString().ToLower()" />
        <div class="ds-filter-row">
            <div class="ds-filter-search-group">
                <div class="ds-filter-field">
                    <label>關鍵字</label>
                    <input type="text" name="keyword" class="form-control ds-search-input-fill" value="@ViewBag.Keyword" placeholder="搜尋帳號, 名稱, Email...">
                </div>
                <div class="ds-filter-actions">
                    <button type="submit" class="btn ds-btn-query"><i class="fas fa-search"></i> 查詢</button>
                    <a href="@Url.Action("Index")" class="btn ds-btn-clear">清除</a>
                </div>
            </div>
            <div class="ds-filter-field">
                <label>狀態</label>
                <select name="statusFilter" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty((string)ViewBag.StatusFilter))">所有狀態</option>
                    <option value="Normal" selected="@(ViewBag.StatusFilter == "Normal")">正常</option>
                    <option value="Warning" selected="@(ViewBag.StatusFilter == "Warning")">警告</option>
                    <option value="Muted" selected="@(ViewBag.StatusFilter == "Muted")">禁言</option>
                    <option value="Suspended" selected="@(ViewBag.StatusFilter == "Suspended")">停權</option>
                </select>
            </div>
            <div class="ds-filter-field">
                <label>等級</label>
                <select name="levelFilter" class="form-select">
                    <option value="">所有等級</option>
                    @foreach (var lv in levelsSorted)
                    {
                        <option value="@lv.LevelID" selected="@(ViewBag.LevelFilter == lv.LevelID)">@lv.LevelName</option>
                    }
                </select>
            </div>
        </div>
    </form>
</div>

<div class="ds-block-title-row">
    <h6>會員列表</h6>
    <span class="ds-muted small">共 @ViewBag.TotalItems 筆</span>
</div>
<div class="ds-table-wrap">
<table class="ds-table align-middle">
    <thead>
        <tr>
            <th>頭像</th>
            <th>帳號</th>
            <th>名稱</th>
            <th>
                等級
                <a href="@Url.Action("Index", new { sortBy = ViewBag.SortBy == "lv_asc" ? "lv_desc" : "lv_asc", keyword = ViewBag.Keyword, statusFilter = ViewBag.StatusFilter, levelFilter = ViewBag.LevelFilter, showAbnormal = ViewBag.ShowAbnormal, todayOnly = ViewBag.TodayOnly })">📐</a>
            </th>
            <th>經驗值</th>
            <th>點數</th>
            <th>
                狀態
                <a href="@Url.Action("Index", new { sortBy = ViewBag.SortBy == "status_asc" ? "status_desc" : "status_asc", keyword = ViewBag.Keyword, statusFilter = ViewBag.StatusFilter, levelFilter = ViewBag.LevelFilter, showAbnormal = ViewBag.ShowAbnormal, todayOnly = ViewBag.TodayOnly })">📐</a>
            </th>
            <th>
                註冊時間
                <a href="@Url.Action("Index", new { sortBy = ViewBag.SortBy == "created_asc" ? "created_desc" : "created_asc", keyword = ViewBag.Keyword, statusFilter = ViewBag.StatusFilter, levelFilter = ViewBag.LevelFilter, showAbnormal = ViewBag.ShowAbnormal, todayOnly = ViewBag.TodayOnly })">📐</a>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            var levelIndex = levelsSorted.FindIndex(l => l.LevelID == m.LevelID);
            var levelNumber = levelIndex + 1;
            int? nextThreshold = (levelIndex >= 0 && levelIndex < levelsSorted.Count - 1) ? levelsSorted[levelIndex + 1].MinExp : (int?)null;
            var status = StatusInfo(m.Status);
            var isDeleted = m.IsDeleted;

            <tr class="@(isDeleted ? "opacity-50" : "")"
                style="cursor:pointer;"
                onclick="window.location='@Url.Action("Edit", new { id = m.MemberID })'">
                <td>
                    @if (!string.IsNullOrEmpty(m.AvatarImage?.ImageURL))
                    {
                        <img src="@m.AvatarImage.ImageURL" width="40" height="40" class="rounded-circle" />
                    }
                    else
                    {
                        <img src="@defaultAvatar" width="40" height="40" class="rounded-circle" />
                    }
                </td>
                <td>@m.UserName</td>
                <td>@m.NickName</td>
                <td>LV@(levelNumber) @m.UserLevel?.LevelName</td>
                <td>@m.Experience@(nextThreshold.HasValue ? $" / {nextThreshold}" : " (滿級)")</td>
                <td>@m.Points</td>
                <td>
                    <span class="ds-badge @status.BadgeClass" style="@status.Style">@status.Emoji @status.Label</span>
                </td>
                <td>@m.CreatedAt.ToString("yyyy-MM-dd")</td>
            </tr>
        }
    </tbody>
</table>
</div>

@{
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalItems = ViewBag.TotalItems;
    int pageSize = ViewBag.PageSize;
}
@if (totalItems > 0)
{
    var showStart = (currentPage - 1) * pageSize + 1;
    var showEnd = Math.Min(currentPage * pageSize, totalItems);
    <div class="sp-pagination">
        <div class="sp-summary">目前顯示 @showStart–@showEnd 筆，共 @totalItems 筆</div>
        <nav aria-label="會員列表分頁">
            <ul class="pagination">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Math.Max(1, currentPage - 1), keyword = ViewBag.Keyword, statusFilter = ViewBag.StatusFilter, levelFilter = ViewBag.LevelFilter, showAbnormal = ViewBag.ShowAbnormal, todayOnly = ViewBag.TodayOnly, sortBy = ViewBag.SortBy })">上一頁</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, keyword = ViewBag.Keyword, statusFilter = ViewBag.StatusFilter, levelFilter = ViewBag.LevelFilter, showAbnormal = ViewBag.ShowAbnormal, todayOnly = ViewBag.TodayOnly, sortBy = ViewBag.SortBy })">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Math.Min(totalPages, currentPage + 1), keyword = ViewBag.Keyword, statusFilter = ViewBag.StatusFilter, levelFilter = ViewBag.LevelFilter, showAbnormal = ViewBag.ShowAbnormal, todayOnly = ViewBag.TodayOnly, sortBy = ViewBag.SortBy })">下一頁</a>
                </li>
            </ul>
        </nav>
    </div>
}
