@model MidProject.Models.ViewModels.Dashboard.DashboardDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.Title</h1>
        <p class="text-muted mb-0">@Model.Description</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>返回 Dashboard
    </a>
</div>

@if (!Model.IsAvailable)
{
    <div class="card">
        <div class="card-body py-5 text-center">
            <i class="fas fa-users fa-3x text-secondary mb-3"></i>
            <h2 class="h5">@(Model.UnavailableReason ?? "此項目尚未整合")</h2>
            <p class="text-muted mb-0">@Model.QuerySummary</p>
        </div>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card h-100 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="text-uppercase small fw-semibold text-primary mb-2">統計數字</div>
                    <div class="display-5 fw-bold">@Model.TotalCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card h-100">
                <div class="card-header"><h2 class="h5 mb-0">查詢條件摘要</h2></div>
                <div class="card-body"><p class="mb-0 text-muted">@Model.QuerySummary</p></div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center gap-3">
            <h2 class="h5 mb-0">資料明細</h2>
            @if (!string.IsNullOrWhiteSpace(Model.ModuleUrl))
            {
                <a href="@Model.ModuleUrl" class="btn btn-primary btn-sm">@Model.ModuleLinkText</a>
            }
        </div>
        <div class="card-body">
            @if (Model.Rows.Count == 0)
            {
                <div class="text-center text-muted py-4">目前沒有符合條件的資料。</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                @foreach (var header in Model.Headers)
                                {
                                    <th>@header</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                <tr>
                                    @foreach (var value in row.Values)
                                    {
                                        <td>@value</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
