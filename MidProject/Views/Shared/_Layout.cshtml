@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isRestaurantGroup = currentController is "Restaurants" or "Tags";
    var isHome = currentController == "Home";
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 美食地圖</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MidProject.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">美食地圖</a>
            <nav>
                <a class="nav-item @(isHome ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">基礎架構</a>

                <button class="nav-group-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#navRestaurants"
                        aria-expanded="@(isRestaurantGroup ? "true" : "false")" aria-controls="navRestaurants">
                    餐廳
                    <span class="chevron"></span>
                </button>
                <div class="collapse nav-group @(isRestaurantGroup ? "show" : "")" id="navRestaurants">
                    <a class="nav-item @(currentController == "Restaurants" && currentAction == "Index" ? "active" : "")"
                       asp-controller="Restaurants" asp-action="Index">餐廳一覽</a>
                    <a class="nav-item @(currentController == "Tags" ? "active" : "")"
                       asp-controller="Tags" asp-action="Index">餐廳標籤一覽</a>
                    <a class="nav-item @(currentController == "Restaurants" && currentAction == "Deleted" ? "active" : "")"
                       asp-controller="Restaurants" asp-action="Deleted">停用餐廳一覽</a>
                </div>

                <span class="nav-item disabled" title="尚未開放，由負責的組員實作">會員管理</span>
                <span class="nav-item disabled" title="尚未開放，由負責的組員實作">評論管理</span>
                <span class="nav-item disabled" title="尚未開放，由負責的組員實作">檢舉管理</span>
            </nav>
        </aside>

        <div class="main">
            <main role="main">
                @RenderBody()
            </main>
            <footer>
                &copy; 2026 - 美食地圖
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
