@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    string NavActive(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    bool IsCurrent(string controller, string action) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    var dashboardActive = currentController is "Home" or "Dashboard" ? "active" : string.Empty;
    var restaurantsGroupActive = currentController is "Restaurants" or "Tags";
    var pointsStoreGroupActive = currentController is "AvatarFrames" or "PointsStoreRedemptions";
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 美食地圖後台</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/vendor/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MidProject.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar collapse d-lg-flex" id="adminSidebar">
            <a class="admin-brand" asp-controller="Home" asp-action="Index">
                <i class="fas fa-utensils"></i>
                <span>美食地圖後台</span>
            </a>

            <nav class="admin-nav" aria-label="後台主要導覽">
                <a class="admin-nav-link @dashboardActive" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-tachometer-alt"></i><span>Dashboard</span>
                </a>
                <a class="admin-nav-link @NavActive("AdminMembers")" asp-controller="AdminMembers" asp-action="Index">
                    <i class="fas fa-users"></i><span>會員管理</span>
                </a>
                <div class="admin-nav-group">
                    <button class="admin-nav-link admin-nav-group-toggle @(restaurantsGroupActive ? "active" : "")" type="button"
                            data-bs-toggle="collapse" data-bs-target="#navRestaurantsGroup"
                            aria-expanded="@(restaurantsGroupActive ? "true" : "false")" aria-controls="navRestaurantsGroup">
                        <i class="fas fa-store"></i><span>餐廳管理</span><i class="fas fa-chevron-down admin-nav-chevron"></i>
                    </button>
                    <div class="collapse admin-nav-subgroup @(restaurantsGroupActive ? "show" : "")" id="navRestaurantsGroup">
                        <a class="admin-nav-sublink @(IsCurrent("Restaurants", "Index") ? "active" : "")" asp-controller="Restaurants" asp-action="Index">餐廳一覽</a>
                        <a class="admin-nav-sublink @(IsCurrent("Restaurants", "Deleted") ? "active" : "")" asp-controller="Restaurants" asp-action="Deleted">停用餐廳一覽</a>
                        <a class="admin-nav-sublink @(IsCurrent("Tags", "Index") ? "active" : "")" asp-controller="Tags" asp-action="Index">餐廳標籤一覽</a>
                    </div>
                </div>
                <div class="admin-nav-group">
                    <button class="admin-nav-link admin-nav-group-toggle @(pointsStoreGroupActive ? "active" : "")" type="button"
                            data-bs-toggle="collapse" data-bs-target="#navPointsStoreGroup"
                            aria-expanded="@(pointsStoreGroupActive ? "true" : "false")" aria-controls="navPointsStoreGroup">
                        <i class="fas fa-coins"></i><span>點數商城</span><i class="fas fa-chevron-down admin-nav-chevron"></i>
                    </button>
                    <div class="collapse admin-nav-subgroup @(pointsStoreGroupActive ? "show" : "")" id="navPointsStoreGroup">
                        <a class="admin-nav-sublink @(IsCurrent("AvatarFrames", "Index") ? "active" : "")" asp-controller="AvatarFrames" asp-action="Index">外框商品管理</a>
                        <a class="admin-nav-sublink @(IsCurrent("AvatarFrames", "Deleted") ? "active" : "")" asp-controller="AvatarFrames" asp-action="Deleted">已刪除商品</a>
                        <a class="admin-nav-sublink @(IsCurrent("PointsStoreRedemptions", "Index") ? "active" : "")" asp-controller="PointsStoreRedemptions" asp-action="Index">兌換紀錄</a>
                    </div>
                </div>
                <a class="admin-nav-link @NavActive("Reviews")" asp-controller="Reviews" asp-action="Index">
                    <i class="fas fa-comments"></i><span>評論管理</span>
                </a>
                <a class="admin-nav-link @NavActive("Reports")" asp-controller="Reports" asp-action="Dashboard">
                    <i class="fas fa-flag"></i><span>檢舉管理</span>
                </a>
                <a class="admin-nav-link @NavActive("Notifications")" asp-controller="Notifications" asp-action="Index">
                    <i class="fas fa-bell"></i><span>通知管理</span>
                </a>
            </nav>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar navbar navbar-expand bg-white border-bottom shadow-sm">
                <div class="container-fluid px-3 px-lg-4">
                    <button class="btn btn-outline-secondary d-lg-none" type="button" data-bs-toggle="collapse"
                            data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-expanded="false" aria-label="切換導覽列">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div class="ms-auto d-flex align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="navbar-text d-flex align-items-center gap-2">
                                <i class="fas fa-user-circle text-secondary"></i>
                                <span>@User.Identity.Name</span>
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-sign-out-alt me-1"></i>登出
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-sign-in-alt me-1"></i>管理員登入
                            </a>
                        }
                    </div>
                </div>
            </header>

            <main class="admin-content" role="main">
                <div class="container-fluid px-3 px-lg-4 py-4">
                    @RenderBody()
                </div>
            </main>

            <footer class="admin-footer border-top bg-white text-muted">
                <div class="container-fluid px-3 px-lg-4 py-3 text-center">
                    &copy; @DateTime.Now.Year 美食地圖管理系統
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
