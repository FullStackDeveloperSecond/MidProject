@model MidProject.Models.ViewModels.Restaurants.RestaurantIndexViewModel
@{
    ViewData["Title"] = "餐廳一覽";
}

@section Styles {
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/restaurant-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared-pagination.css" asp-append-version="true" />
}

<div class="ra-page">
    <div id="raContent">
        @await Html.PartialAsync("_IndexContent", Model)
    </div>
    <div id="raContentOverlay" class="page-loading-overlay" aria-hidden="true">
        <div class="page-loading-content">
            <div class="page-loading-spinner"></div>
            <p>載入中... 請稍後</p>
        </div>
    </div>
</div>

<div id="modalRoot" class="modal-root" aria-hidden="true"></div>
<div id="toast" class="toast" role="status"></div>

@section Scripts {
    <script src="~/js/restaurant-admin.js" asp-append-version="true"></script>
    <script>
        function bindCreateRestaurantButton() {
            const button = document.getElementById('addRestaurantBtn');
            if (button && !button.dataset.bound) {
                button.dataset.bound = 'true';
                button.addEventListener('click', () => RestaurantAdmin.openCreateModal());
            }
        }
        RestaurantAdmin.bindAjaxContent({
            contentId: 'raContent',
            overlayId: 'raContentOverlay',
            formId: 'filterForm',
            afterRender: function () {
                bindCreateRestaurantButton();
                document.querySelectorAll('.js-edit-btn').forEach(btn => {
                    btn.addEventListener('click', () => RestaurantAdmin.openEditModal(btn.dataset.id));
                });
                RestaurantAdmin.initFilterDistrictCascade();
            }
        });
    </script>
}
