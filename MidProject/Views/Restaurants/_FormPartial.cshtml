@model MidProject.Models.ViewModels.Restaurants.RestaurantFormViewModel
@using MidProject.Models.ViewModels.Restaurants
@{
    var isEdit = Model.IsEdit;
}

<div class="ra-modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-head">
        <h2 id="modalTitle">@(isEdit ? "編輯餐廳" : "新增餐廳")</h2>
        <button type="button" class="btn btn-icon" data-action="close-modal" aria-label="關閉">×</button>
    </div>
    <form id="restaurantForm" method="post" enctype="multipart/form-data" autocomplete="off"
          action="@(isEdit ? Url.Action("Edit", new { id = Model.Id }) : Url.Action("Create"))">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" id="hoursJsonInput" name="HoursJson" value="@BusinessHoursJsonHelper.ToJson(Model.Hours)" />
        <script type="application/json" id="cityDistrictsJson">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(RestaurantOptions.CityDistricts))</script>

        <div class="modal-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert">
                    <ul>
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <section class="form-section">
                <h3>基本資料</h3>
                <div class="form-grid">
                    <label class="field">
                        <span>餐廳名稱 <b class="required">*</b></span>
                        <input class="input" name="Name" value="@Model.Name" required maxlength="100">
                    </label>
                    <label class="field">
                        <span>電話</span>
                        <input class="input" name="Phone" value="@Model.Phone" maxlength="20">
                    </label>
                    <label class="field">
                        <span>縣市 <b class="required">*</b></span>
                        <select class="select" name="City" id="citySelect" required autocomplete="off" data-selected="@Model.City">
                            <option value="">請選擇</option>
                            @foreach (var city in RestaurantOptions.Cities)
                            {
                                <option value="@city" selected="@(city == Model.City)">@city</option>
                            }
                        </select>
                    </label>
                    <label class="field">
                        <span>行政區 <b class="required">*</b></span>
                        <select class="select" name="District" id="districtSelect" required autocomplete="off" data-selected="@Model.District">
                            <option value="">@(string.IsNullOrEmpty(Model.City) ? "請先選擇縣市" : "請選擇")</option>
                            @if (!string.IsNullOrEmpty(Model.City) && RestaurantOptions.CityDistricts.TryGetValue(Model.City, out var currentDistricts))
                            {
                                @foreach (var district in currentDistricts)
                                {
                                    <option value="@district" selected="@(district == Model.District)">@district</option>
                                }
                            }
                        </select>
                    </label>
                </div>
                <label class="field">
                    <span>詳細地址 <b class="required">*</b></span>
                    <input class="input" name="DetailedAddress" value="@Model.DetailedAddress" required maxlength="200">
                </label>
                <div class="form-grid">
                    <label class="field">
                        <span>Latitude（選填）</span>
                        <input class="input" type="number" step="0.000001" min="-90" max="90" name="Latitude" value="@Model.Latitude">
                    </label>
                    <label class="field">
                        <span>Longitude（選填）</span>
                        <input class="input" type="number" step="0.000001" min="-180" max="180" name="Longitude" value="@Model.Longitude">
                    </label>
                </div>
                <label class="field">
                    <span>備註</span>
                    <textarea class="textarea" name="Note" maxlength="1000" placeholder="例如：幾月幾號臨時公休、禁止寵物入內等。">@Model.Note</textarea>
                </label>
                <p class="hint">備註對應 Restaurants.Note，最多建議 1000 字。</p>
            </section>

            <section class="form-section">
                <h3>標籤 <b class="required">*</b></h3>
                <div class="choice-grid" id="tagChoices">
                    @foreach (var tag in Model.AvailableTags)
                    {
                        <input type="checkbox" class="tag-checkbox" id="tag_@tag.Id" name="SelectedTagIds" value="@tag.Id" checked="@tag.Selected">
                        <label class="choice" for="tag_@tag.Id">@tag.Name</label>
                    }
                </div>
            </section>

            <section class="form-section">
                <h3>營業時間</h3>
                <button type="button" class="btn" id="copyFirstDayBtn">套用週一至全週</button>
                <div class="hours-form" id="hoursForm"></div>
            </section>

            <section class="form-section">
                <h3>餐廳圖片</h3>
                <p class="hint">陽春版檔案上傳，先不做裁切/壓縮，正式圖片介面之後由愷/Alex 提供。</p>
                <div class="image-manager">
                    <article class="image-uploader">
                        <div>
                            <strong>餐廳封面圖</strong>
                            <p>JPG / PNG / WebP，5MB 以內</p>
                        </div>
                        <label class="btn">選擇圖片
                            <input type="file" id="coverImageInput" name="CoverImageFile" accept="image/jpeg,image/png,image/webp" hidden>
                        </label>
                    </article>
                    <article class="image-uploader">
                        <div>
                            <strong>餐廳環境圖</strong>
                            <p>JPG / PNG / WebP，5MB 以內，可多張</p>
                        </div>
                        <label class="btn">選擇圖片
                            <input type="file" id="envImageInput" name="EnvironmentImageFiles" accept="image/jpeg,image/png,image/webp" multiple hidden>
                        </label>
                    </article>
                </div>

                <div id="coverPreview" class="image-preview-list">
                    @if (!string.IsNullOrEmpty(Model.ExistingCoverImageUrl))
                    {
                        <article class="image-preview-card">
                            <img src="@Model.ExistingCoverImageUrl" alt="封面圖">
                            <div>
                                <strong>目前封面圖</strong>
                                <label><input type="checkbox" name="RemoveCoverImage" value="true"> 移除封面圖</label>
                            </div>
                        </article>
                    }
                </div>

                <div id="envPreview" class="image-preview-list">
                    @foreach (var img in Model.ExistingEnvironmentImages)
                    {
                        <article class="image-preview-card">
                            <img src="@img.Url" alt="環境圖">
                            <div>
                                <strong>既有環境圖</strong>
                                <label><input type="checkbox" name="RemoveEnvironmentImageIds" value="@img.ImageId"> 移除這張</label>
                            </div>
                        </article>
                    }
                </div>
                <div id="newImagePreview" class="image-preview-list"></div>
            </section>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn" data-action="close-modal">取消</button>
            <button type="submit" class="btn btn-primary">@(isEdit ? "儲存變更" : "新增餐廳")</button>
        </div>
    </form>
</div>
