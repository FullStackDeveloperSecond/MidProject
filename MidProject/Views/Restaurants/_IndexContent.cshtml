@model MidProject.Models.ViewModels.Restaurants.RestaurantIndexViewModel
@using MidProject.Models.ViewModels.Restaurants

<div class="ds-page-header d-flex justify-content-between align-items-start">
    <div>
        <h1 class="ds-h2 mb-1">餐廳一覽</h1>
        <p>管理餐廳資料、標籤與營業狀態</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary" id="addRestaurantBtn">+ 新增餐廳</button>
    </div>
</div>

@if (TempData["Toast"] != null)
{
    <div class="alert">@TempData["Toast"]</div>
}

@{
    var hasActiveFilter = !string.IsNullOrWhiteSpace(Model.Filter.Search) || !string.IsNullOrWhiteSpace(Model.Filter.City)
        || !string.IsNullOrWhiteSpace(Model.Filter.District) || Model.Filter.TagId.HasValue;
}
<div class="row g-2 mb-3">
    <div class="col-6 col-lg-3">
        <div class="ds-stat-card ds-stat-card-sm">
            <div class="d-flex justify-content-between align-items-start">
                <div class="ds-stat-label ds-accent-success">餐廳總數</div>
                <span class="ds-stat-icon ds-icon-success"><i class="fas fa-store"></i></span>
            </div>
            <div class="ds-stat-value">@Model.StatsTotal</div>
            @if (hasActiveFilter) { <div class="ds-stat-caption">符合目前篩選</div> }
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ds-stat-card ds-stat-card-sm">
            <div class="d-flex justify-content-between align-items-start">
                <div class="ds-stat-label ds-accent-warning">平均星級</div>
                <span class="ds-stat-icon ds-icon-warning"><i class="fas fa-star"></i></span>
            </div>
            <div class="ds-stat-value">@Model.StatsAvgRating.ToString("0.0")</div>
            @if (hasActiveFilter) { <div class="ds-stat-caption">符合目前篩選</div> }
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ds-stat-card ds-stat-card-sm">
            <div class="d-flex justify-content-between align-items-start">
                <div class="ds-stat-label ds-accent-primary">評論總數</div>
                <span class="ds-stat-icon ds-icon-primary"><i class="fas fa-comments"></i></span>
            </div>
            <div class="ds-stat-value">@Model.StatsReviewCount</div>
            @if (hasActiveFilter) { <div class="ds-stat-caption">符合目前篩選</div> }
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ds-stat-card ds-stat-card-sm">
            <div class="d-flex justify-content-between align-items-start">
                <div class="ds-stat-label ds-accent-danger">停用中</div>
                <span class="ds-stat-icon ds-icon-danger"><i class="fas fa-ban"></i></span>
            </div>
            <div class="ds-stat-value">@Model.StatsDisabledCount</div>
            @if (hasActiveFilter) { <div class="ds-stat-caption">符合目前篩選</div> }
        </div>
    </div>
</div>

@{
    var searchChanged = !string.IsNullOrWhiteSpace(Model.Filter.Search) ? "filter-changed" : "";
    var cityChanged = !string.IsNullOrWhiteSpace(Model.Filter.City) ? "filter-changed" : "";
    var districtChanged = !string.IsNullOrWhiteSpace(Model.Filter.District) ? "filter-changed" : "";
    var tagChanged = Model.Filter.TagId.HasValue ? "filter-changed" : "";
    var sortChanged = Model.Filter.Sort != "newest" ? "filter-changed" : "";
}
<form method="get"
      asp-action="Index"
      class="toolbar ds-toolbar"
      id="filterForm"
      data-filter-keyword-name="Search"
      data-applied-keyword="@Model.Filter.Search">
    <h6 class="ds-block-label">篩選條件</h6>
    <div class="ds-filter-row">
        <div class="ds-filter-search-group">
            <div class="ds-filter-field">
                <label>關鍵字</label>
                <input class="input @searchChanged ds-search-input-fill" type="search" name="Search" value="@Model.Filter.Search" placeholder="搜尋餐廳名稱、上傳會員...">
            </div>
            <div class="ds-filter-actions">
                <button type="submit" class="btn ds-btn-query"><i class="fas fa-search"></i> 查詢</button>
                <a class="btn ds-btn-clear" href="@Url.Action("Index")">清除</a>
            </div>
        </div>
        <div class="ds-filter-field">
            <label for="filterCitySelect">縣市</label>
            <select class="select @cityChanged" name="City" id="filterCitySelect">
                <option value="">全部縣市</option>
                @foreach (var city in Model.AvailableCities)
                {
                    <option value="@city" selected="@(city == Model.Filter.City)">@city</option>
                }
            </select>
        </div>
        <div class="ds-filter-field">
            <label for="filterDistrictSelect">行政區</label>
            <select class="select @districtChanged" name="District" id="filterDistrictSelect" data-selected="@Model.Filter.District" data-auto-submit>
                <option value="">全部行政區</option>
                @foreach (var city in RestaurantOptions.CityDistricts.Keys)
                {
                    <optgroup label="@city">
                        @foreach (var district in RestaurantOptions.CityDistricts[city])
                        {
                            <option value="@district" selected="@(district == Model.Filter.District)">@district</option>
                        }
                    </optgroup>
                }
            </select>
        </div>
        <div class="ds-filter-field">
            <label>標籤</label>
            <select class="select @tagChanged" name="TagId" data-auto-submit>
                <option value="">全部標籤</option>
                @foreach (var tag in Model.AvailableTags)
                {
                    <option value="@tag.Id" selected="@(Model.Filter.TagId == tag.Id)">@tag.Name</option>
                }
            </select>
        </div>
        <div class="ds-filter-field">
            <label>排序</label>
            <select class="select @sortChanged" name="Sort" data-auto-submit>
                <option value="newest" selected="@(Model.Filter.Sort == "newest")">最新新增</option>
                <option value="rating" selected="@(Model.Filter.Sort == "rating")">星級最高</option>
                <option value="review" selected="@(Model.Filter.Sort == "review")">評論最多</option>
            </select>
        </div>
    </div>
</form>
<script type="application/json" id="filterCityDistrictsJson">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(RestaurantOptions.CityDistricts))</script>

<div class="ds-block-title-row">
    <h6>餐廳列表</h6>
    <div class="d-flex align-items-center gap-3">
        <span class="ds-muted small">共 @Model.TotalItems 筆</span>
        <div class="ra-view-toggle" role="group" aria-label="切換檢視模式">
            <button type="button" class="js-view-btn" data-view="table" aria-pressed="true">
                <i class="fas fa-list"></i> 表格
            </button>
            <button type="button" class="js-view-btn" data-view="card" aria-pressed="false">
                <i class="fas fa-grip"></i> 卡片
            </button>
        </div>
    </div>
</div>
<div class="ds-table-wrap js-view-panel" data-view="table">
    <table class="ds-table">
        <thead>
            <tr>
                <th>餐廳名稱</th>
                <th>縣市 / 行政區</th>
                <th>標籤</th>
                <th>電話</th>
                <th>星級</th>
                <th>評論數</th>
                <th>被收藏數</th>
                <th>上傳會員</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="9" class="muted">目前沒有符合條件的餐廳。</td></tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    <tr class="ra-row">
                        <td><strong>@item.Name</strong></td>
                        <td>@item.City · @item.District</td>
                        <td>
                            @foreach (var tag in item.Tags)
                            {
                                <span class="ds-badge @TagColorPalette.GetColorClass(tag)">@tag</span>
                            }
                        </td>
                        <td class="muted">@item.Phone</td>
                        <td><span class="stars">★</span>@item.Rating.ToString("0.0")</td>
                        <td>@item.ReviewCount</td>
                        <td><i class="fas fa-heart" style="color:var(--ra-cta);font-size:12px;"></i> @item.FavoriteCount</td>
                        <td class="muted">@(item.UploaderName ?? "-")</td>
                        <td>
                            <a class="ds-icon-btn ds-icon-btn-view" title="查看" aria-label="查看" href="@Url.Action("Details", new { id = item.Id })">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                            </a>
                            <button type="button" class="ds-icon-btn ds-icon-btn-edit js-edit-btn" title="編輯" aria-label="編輯" data-id="@item.Id">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="ra-card-grid js-view-panel" data-view="card" hidden>
    @if (!Model.Items.Any())
    {
        <p class="muted">目前沒有符合條件的餐廳。</p>
    }
    else
    {
        foreach (var item in Model.Items)
        {
            <article class="ra-restaurant-card">
                <div class="ra-rc-top">
                    <div>
                        <div class="ra-rc-name">@item.Name</div>
                        <div class="ra-rc-loc">@item.City · @item.District</div>
                    </div>
                    <div class="ra-rc-actions">
                        <a class="ds-icon-btn ds-icon-btn-view" title="查看" aria-label="查看" href="@Url.Action("Details", new { id = item.Id })">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                        </a>
                        <button type="button" class="ds-icon-btn ds-icon-btn-edit js-edit-btn" title="編輯" aria-label="編輯" data-id="@item.Id">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                        </button>
                    </div>
                </div>
                <div class="ra-rc-tags">
                    @foreach (var tag in item.Tags)
                    {
                        <span class="ds-badge @TagColorPalette.GetColorClass(tag)">@tag</span>
                    }
                </div>
                <div class="ra-rc-meta">
                    <span class="muted">@(item.UploaderName ?? "-") 上傳 · @item.Phone</span>
                    <span class="d-flex align-items-center gap-2">
                        <span class="ra-rc-rating"><span class="stars">★</span> @item.Rating.ToString("0.0") <span class="muted">(@item.ReviewCount 則)</span></span>
                        <span class="muted"><i class="fas fa-heart" style="color:var(--ra-cta);font-size:12px;"></i> @item.FavoriteCount</span>
                    </span>
                </div>
            </article>
        }
    }
</div>

@{
    var showStart = Model.TotalItems == 0 ? 0 : (Model.CurrentPage - 1) * Model.PageSize + 1;
    var showEnd = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems);
}
<div class="sp-pagination">
    <div class="sp-summary">目前顯示 @showStart–@showEnd 筆，共 @Model.TotalItems 筆</div>
    <nav aria-label="分頁導覽">
        <ul class="pagination">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { Search = Model.Filter.Search, City = Model.Filter.City, District = Model.Filter.District, TagId = Model.Filter.TagId, Sort = Model.Filter.Sort, Page = Math.Max(1, Model.CurrentPage - 1) })">上一頁</a>
            </li>
            @foreach (var pageNumber in PaginationWindow.GetPageNumbers(Model.CurrentPage, Model.TotalPages))
            {
                <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { Search = Model.Filter.Search, City = Model.Filter.City, District = Model.Filter.District, TagId = Model.Filter.TagId, Sort = Model.Filter.Sort, Page = pageNumber })">@pageNumber</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { Search = Model.Filter.Search, City = Model.Filter.City, District = Model.Filter.District, TagId = Model.Filter.TagId, Sort = Model.Filter.Sort, Page = Math.Min(Model.TotalPages, Model.CurrentPage + 1) })">下一頁</a>
            </li>
        </ul>
    </nav>
</div>
