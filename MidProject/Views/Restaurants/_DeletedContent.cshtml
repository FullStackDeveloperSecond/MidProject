@model MidProject.Models.ViewModels.Restaurants.RestaurantDeletedIndexViewModel
@using MidProject.Models.ViewModels.Restaurants

<div class="ds-page-header">
    <h1 class="ds-h2 mb-1">停用餐廳一覽</h1>
    <p>檢視已停用（軟刪除）的餐廳，可查看詳情或解除停用</p>
</div>

@if (TempData["Toast"] != null)
{
    <div class="alert">@TempData["Toast"]</div>
}

<div class="ra-warning-banner">
    <span class="ra-warning-icon" aria-hidden="true">!</span>
    <span>以下餐廳已停用（IsDeleted = 1），一般用戶不可見。點擊進入詳細頁面可編輯或解除停用。</span>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <div class="ds-stat-card ds-stat-card-sm h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div class="ds-stat-label ds-accent-danger">停用總數</div>
                <span class="ds-stat-icon ds-icon-danger"><i class="fas fa-ban"></i></span>
            </div>
            <div class="ds-stat-value">@Model.StatsDisabledTotal</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ds-stat-card ds-stat-card-sm h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div class="ds-stat-label ds-accent-gray">最近停用</div>
                <span class="ds-stat-icon ds-icon-gray"><i class="fas fa-clock"></i></span>
            </div>
            <div class="ds-stat-value">@(Model.StatsMostRecentAt?.ToString("yyyy-MM-dd") ?? "-")</div>
            <div class="ds-stat-caption">@(Model.StatsMostRecentName ?? "-")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ds-stat-card ds-stat-card-sm h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div class="ds-stat-label ds-accent-gray">前次停用原因</div>
                <span class="ds-stat-icon ds-icon-gray"><i class="fas fa-circle-info"></i></span>
            </div>
            <div class="ds-stat-value" style="font-size: 24px;">@(Model.StatsLastReason ?? "-")</div>
        </div>
    </div>
</div>

<form method="get"
      asp-action="Deleted"
      class="toolbar ds-toolbar"
      id="filterForm"
      data-filter-keyword-name="Search"
      data-applied-keyword="@Model.Filter.Search">
    <h6 class="ds-block-label">篩選條件</h6>
    <div class="ds-filter-row">
        <div class="ds-filter-search-group">
            <div class="ds-filter-field">
                <label>關鍵字</label>
                <input class="input ds-search-input-fill" type="search" name="Search" value="@Model.Filter.Search" placeholder="搜尋停用餐廳...">
            </div>
            <div class="ds-filter-actions">
                <button type="submit" class="btn ds-btn-query"><i class="fas fa-search"></i> 查詢</button>
                <a class="btn ds-btn-clear" href="@Url.Action("Deleted")">清除</a>
            </div>
        </div>
        <div class="ds-filter-field">
            <label>縣市</label>
            <select class="select" name="City" data-auto-submit>
                <option value="">全部縣市</option>
                @foreach (var city in Model.AvailableCities)
                {
                    <option value="@city" selected="@(city == Model.Filter.City)">@city</option>
                }
            </select>
        </div>
        <div class="ds-filter-field">
            <label>停用原因</label>
            <select class="select" name="Reason" data-auto-submit>
                <option value="">全部停用原因</option>
                @foreach (var reason in Model.AvailableReasons)
                {
                    <option value="@reason" selected="@(reason == Model.Filter.Reason)">@reason</option>
                }
            </select>
        </div>
    </div>
</form>

<div class="ds-block-title-row">
    <h6>停用餐廳列表</h6>
    <span class="ds-muted small">共 @Model.TotalItems 筆</span>
</div>
<div class="ds-table-wrap">
    <table class="ds-table">
        <thead>
            <tr>
                <th>餐廳名稱</th>
                <th>縣市 / 行政區</th>
                <th>標籤</th>
                <th>停用時間</th>
                <th>停用原因</th>
                <th>執行者</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="7" class="muted">目前沒有停用餐廳。</td></tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    <tr class="ra-row">
                        <td><strong>@item.Name</strong></td>
                        <td>@item.City · @item.District</td>
                        <td>
                            @foreach (var tag in item.Tags)
                            {
                                <span class="ds-badge ds-badge-gray">@tag</span>
                            }
                        </td>
                        <td class="muted">@(item.DeletedAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td><span class="ds-badge ds-badge-danger">@item.DeleteReason</span></td>
                        <td class="muted">@item.DeletedByName</td>
                        <td>
                            <a class="ds-icon-btn ds-icon-btn-view" title="查看" aria-label="查看" href="@Url.Action("Details", new { id = item.Id })">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                            </a>
                            <button type="button" class="ds-icon-btn ds-icon-btn-edit js-edit-btn" title="編輯" aria-label="編輯" data-id="@item.Id">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.TotalItems > 0)
{
    var showStart = (Model.CurrentPage - 1) * Model.PageSize + 1;
    var showEnd = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems);
    <div class="sp-pagination">
        <div class="sp-summary">目前顯示 @showStart–@showEnd 筆，共 @Model.TotalItems 筆</div>
        <nav aria-label="分頁導覽">
            <ul class="pagination">
                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Deleted", new { Search = Model.Filter.Search, City = Model.Filter.City, Reason = Model.Filter.Reason, Page = Math.Max(1, Model.CurrentPage - 1) })">上一頁</a>
                </li>
                @foreach (var pageNumber in PaginationWindow.GetPageNumbers(Model.CurrentPage, Model.TotalPages))
                {
                    <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Deleted", new { Search = Model.Filter.Search, City = Model.Filter.City, Reason = Model.Filter.Reason, Page = pageNumber })">@pageNumber</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Deleted", new { Search = Model.Filter.Search, City = Model.Filter.City, Reason = Model.Filter.Reason, Page = Math.Min(Model.TotalPages, Model.CurrentPage + 1) })">下一頁</a>
                </li>
            </ul>
        </nav>
    </div>
}
