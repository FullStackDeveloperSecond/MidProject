@model MidProject.Models.DTOs.ReportDashboardDto

@{
    ViewData["Title"] = "檢舉統計";
}

@section Styles {
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
}

<div class="ds-page-header">
    <h1 class="ds-h2 mb-1">檢舉統計</h1>
    <p>檢視檢舉處理狀態與每月案件趨勢</p>
</div>

<div class="ds-block-label">累計</div>

<div class="row g-3 mb-4">
    <div class="col-xl-4 col-md-6">
        <a asp-action="Index" asp-route-Status="Pending" class="ds-stat-card d-block text-decoration-none text-reset">
            <div class="d-flex justify-content-between align-items-start">
                <div class="ds-stat-label ds-accent-warning">待處理</div>
                <span class="ds-stat-icon ds-icon-warning"><i class="fas fa-folder"></i></span>
            </div>
            <div class="ds-stat-value">@Model.PendingCount</div>
            @if (Model.PendingNewThisMonth > 0)
            {
                <div class="ds-stat-trend" style="color:var(--ds-success);">
                    <i class="fas fa-arrow-up"></i> @Model.PendingNewThisMonth new this month
                </div>
            }
        </a>
    </div>

    <div class="col-xl-4 col-md-6">
        <a asp-action="Index" asp-route-Status="Approved" class="ds-stat-card d-block text-decoration-none text-reset">
            <div class="d-flex justify-content-between align-items-start">
                <div class="ds-stat-label ds-accent-success">檢舉成立</div>
                <span class="ds-stat-icon ds-icon-success"><i class="fas fa-check-circle"></i></span>
            </div>
            <div class="ds-stat-value">@Model.ApprovedCount</div>
        </a>
    </div>

    <div class="col-xl-4 col-md-6">
        <a asp-action="Index" asp-route-Status="Rejected" class="ds-stat-card d-block text-decoration-none text-reset">
            <div class="d-flex justify-content-between align-items-start">
                <div class="ds-stat-label ds-accent-gray">駁回檢舉</div>
                <span class="ds-stat-icon ds-icon-gray"><i class="fas fa-exclamation-triangle"></i></span>
            </div>
            <div class="ds-stat-value">@Model.RejectedCount</div>
        </a>
    </div>
</div>

<div class="ds-block-title-row">
    <h6>每月統計（近 12 個月）</h6>
    <a asp-action="Index" class="btn ds-btn-query">查看檢舉列表</a>
</div>
<div class="ds-card p-4 mb-4">
    <div class="report-chart">
        <canvas id="monthlyReportsChart"></canvas>
    </div>
</div>

@section Scripts {
    <script src="~/vendor/chart.js/Chart.min.js"></script>
    <script>
        (function () {
            var months = @Html.Raw(Json.Serialize(Model.MonthlyStats.Select(m => m.MonthLabel)));
            var approvedData = @Html.Raw(Json.Serialize(Model.MonthlyStats.Select(m => m.Approved)));
            var rejectedData = @Html.Raw(Json.Serialize(Model.MonthlyStats.Select(m => m.Rejected)));
            var pendingData = @Html.Raw(Json.Serialize(Model.MonthlyStats.Select(m => m.Pending)));

            var ctx = document.getElementById("monthlyReportsChart");

            // 注意：SB Admin 2 內建的 Chart.js 通常是 2.x 版，座標軸設定用 xAxes/yAxes（陣列）這種舊寫法。
            // 如果專案裡實際裝的是 Chart.js 3.x/4.x，這段語法會失效，要改成 scales: { x: {...}, y: {...} } 的新寫法。
            new Chart(ctx, {
                type: "bar",
                data: {
                    labels: months,
                    datasets: [
                        {
                            label: "檢舉成立",
                            backgroundColor: "#1F7A6B",
                            data: approvedData
                        },
                        {
                            label: "駁回檢舉",
                            backgroundColor: "#7B746C",
                            data: rejectedData
                        },
                        {
                            label: "待處理",
                            backgroundColor: "#C76716",
                            data: pendingData
                        }
                    ]
                },
                options: {
                    maintainAspectRatio: false,
                    scales: {
                        xAxes: [{
                            stacked: true,
                            gridLines: { display: false }
                        }],
                        yAxes: [{
                            stacked: true,
                            ticks: { beginAtZero: true }
                        }]
                    },
                    legend: { display: true, position: "bottom", labels: { fontSize: 18 } }
                }
            });
        })();
    </script>
}
