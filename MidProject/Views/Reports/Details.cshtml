@model MidProject.Models.DTOs.ReportDto

@{
    ViewData["Title"] = "檢舉詳情";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">檢舉詳情 #@Model.ReportID</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent mb-0 p-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">HOME</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">檢舉管理</a></li>
            <li class="breadcrumb-item active">詳情</li>
        </ol>
    </nav>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <!-- 檢舉內容：欄位與 Index 列表頁一致（編號/處理狀態/檢舉目標/檢舉分類/檢舉者/被檢舉會員/檢舉日期/處理管理員），
             另外補充目標內容、檢舉原因、處理備註這幾項只有詳情頁才需要的細節 -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">檢舉內容</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">編號</dt>
                    <dd class="col-sm-9">@Model.ReportID</dd>

                    <dt class="col-sm-3">處理狀態</dt>
                    <dd class="col-sm-9">
                        @{
                            var badgeClass = Model.Status switch
                            {
                                "Pending" => "badge-warning",
                                "Approved" => "badge-success",
                                "Rejected" => "badge-secondary",
                                _ => "badge-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@Model.StatusDisplay</span>
                    </dd>

                    <dt class="col-sm-3">檢舉目標</dt>
                    <dd class="col-sm-9">@Model.TargetType</dd>

                    <dt class="col-sm-3">檢舉分類</dt>
                    <dd class="col-sm-9">@Model.CategoryDisplay</dd>

                    <dt class="col-sm-3">檢舉者</dt>
                    <dd class="col-sm-9">@Model.ReporterUserName</dd>

                    <dt class="col-sm-3">被檢舉會員</dt>
                    <dd class="col-sm-9">@(Model.ReportedMemberUserName ?? "—")</dd>

                    <dt class="col-sm-3">檢舉日期</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-3">處理管理員</dt>
                    <dd class="col-sm-9">@(Model.HandledByUserName ?? "—")</dd>

                    <dt class="col-sm-3">目標內容</dt>
                    <dd class="col-sm-9">
                        @if (Model.ImageUrl != null)
                        {
                            <img src="@Model.ImageUrl" style="max-width:200px" class="img-thumbnail" />
                        }
                        else
                        {
                            @Model.TargetDisplay
                        }
                    </dd>

                    <dt class="col-sm-3">檢舉原因</dt>
                    <dd class="col-sm-9">@Model.Reason</dd>

                    @if (Model.HandledAt != null)
                    {
                        <dt class="col-sm-3">處理時間</dt>
                        <dd class="col-sm-9">@Model.HandledAt?.ToString("yyyy-MM-dd HH:mm")</dd>

                        <dt class="col-sm-3">處理備註</dt>
                        <dd class="col-sm-9">@Model.AdminNote</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">處理檢舉</h6>
            </div>
            <div class="card-body">
                <form asp-action="Handle" asp-route-id="@Model.ReportID" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="form-label">處理結果</label>
                        <select name="Status" class="form-control">
                            <option value="Approved">檢舉成立</option>
                            <option value="Rejected">駁回檢舉</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">檢舉分類（可修改）</label>
                        <select name="Category" class="form-control">
                            @foreach (var cat in new[] { "不實資訊", "廣告洗版", "人身攻擊", "仇恨言論", "色情內容", "垃圾訊息" })
                            {
                                @if (cat == Model.Category)
                                {
                                    <option value="@cat" selected>@cat</option>
                                }
                                else
                                {
                                    <option value="@cat">@cat</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">管理員備註</label>
                        <textarea name="AdminNote" class="form-control" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check"></i> 送出處理
                    </button>
                </form>
            </div>
        </div>

        @if (Model.Status != "Pending")
        {
            <!-- 只有已經審核完畢（核准/駁回）的檢舉才能通知檢舉會員審核結果 -->
            <div class="card shadow mb-4">
                <div class="card-header py-3 bg-primary">
                    <h6 class="m-0 font-weight-bold text-white">通知檢舉會員</h6>
                </div>
                <div class="card-body">
                    <form asp-action="NotifyReporter" asp-route-id="@Model.ReportID" method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label class="form-label">標題</label>
                            <input type="text" name="Title" class="form-control" value="@Model.DefaultNotificationTitle" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">內容</label>
                            <textarea name="Content" class="form-control" rows="10">@Model.DefaultNotificationContent</textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-paper-plane"></i> 送出
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
