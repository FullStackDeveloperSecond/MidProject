@model MidProject.Models.DTOs.ReportDto

@{
    ViewData["Title"] = "檢舉詳情";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">檢舉詳情 #@Model.ReportID</h1>
        <p class="text-muted mb-0">查看檢舉內容並完成管理員審核</p>
    </div>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent mb-0 p-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">HOME</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">檢舉管理</a></li>
            <li class="breadcrumb-item active">詳情</li>
        </ol>
    </nav>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="關閉"></button>
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <!-- 檢舉內容：欄位與 Index 列表頁一致（編號/處理狀態/檢舉目標/檢舉分類/檢舉者/被檢舉會員/檢舉日期/處理管理員），
             另外補充目標內容、檢舉原因、處理備註這幾項只有詳情頁才需要的細節 -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 fw-bold text-primary">檢舉內容</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">編號</dt>
                    <dd class="col-sm-9">@Model.ReportID</dd>

                    <dt class="col-sm-3">處理狀態</dt>
                    <dd class="col-sm-9">
                        @{
                            var badgeClass = Model.Status switch
                            {
                                "Pending" => "bg-warning text-dark",
                                "Approved" => "bg-success",
                                "Rejected" => "bg-secondary",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@Model.StatusDisplay</span>
                    </dd>

                    <dt class="col-sm-3">檢舉目標</dt>
                    <dd class="col-sm-9">
                        @{
                            var targetController = Model.RestaurantID.HasValue ? "Restaurants"
                                : Model.ReviewID.HasValue ? "Reviews"
                                : null;
                            var targetId = Model.RestaurantID ?? Model.ReviewID ?? Model.ImageID;
                        }
                        @Model.TargetType
                        @if (Model.ImageID.HasValue)
                        {
                            <span class="text-muted">#@Model.ImageID</span>
                        }
                        @if (Model.RestaurantName != null)
                        {
                            @: （
                            @if (targetController != null)
                            {
                                <a asp-controller="@targetController" asp-action="Details" asp-route-id="@targetId">@Model.RestaurantName</a>
                            }
                            else
                            {
                                @Model.RestaurantName
                            }
                            @: ）
                        }
                    </dd>

                    <dt class="col-sm-3">檢舉分類</dt>
                    <dd class="col-sm-9">@Model.CategoryDisplay</dd>

                    <dt class="col-sm-3">檢舉者</dt>
                    <dd class="col-sm-9">
                        <a asp-controller="AdminMembers" asp-action="Edit" asp-route-id="@Model.ReporterMemberID">
                            @Model.ReporterUserName
                        </a>
                    </dd>

                    <dt class="col-sm-3">被檢舉會員</dt>
                    <dd class="col-sm-9">@(Model.ReportedMemberUserName ?? "—")</dd>

                    <dt class="col-sm-3">檢舉日期</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-3">處理管理員</dt>
                    <dd class="col-sm-9">@(Model.HandledByUserName ?? "—")</dd>

                    <dt class="col-sm-3">檢舉原因</dt>
                    <dd class="col-sm-9">@Model.Reason</dd>

                    @if (Model.HandledAt != null)
                    {
                        <dt class="col-sm-3">處理時間</dt>
                        <dd class="col-sm-9">@Model.HandledAt?.ToString("yyyy-MM-dd HH:mm")</dd>

                        <dt class="col-sm-3">處理備註</dt>
                        <dd class="col-sm-9">@Model.AdminNote</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 fw-bold text-primary">處理檢舉</h6>
            </div>
            <div class="card-body">
                <form id="handleForm" asp-action="Handle" asp-route-id="@Model.ReportID" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">處理結果</label>
                        <select name="Status" class="form-select">
                            <option value="Approved">檢舉成立</option>
                            <option value="Rejected">駁回檢舉</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">檢舉分類（可修改）</label>
                        <select name="Category" class="form-select">
                            @foreach (var cat in new[] { "不實資訊", "廣告洗版", "人身攻擊", "仇恨言論", "色情內容", "垃圾訊息" })
                            {
                                @if (cat == Model.Category)
                                {
                                    <option value="@cat" selected>@cat</option>
                                }
                                else
                                {
                                    <option value="@cat">@cat</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">管理員備註</label>
                        <textarea name="AdminNote" class="form-control" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check"></i> 送出處理
                    </button>
                </form>
            </div>
        </div>

        @if (Model.Status != "Pending")
        {
            <!-- 只有已經審核完畢（核准/駁回）的檢舉才能通知檢舉會員審核結果，按下後開啟下方的通知視窗 -->
            <button type="button" class="btn btn-outline-primary w-100 mb-4" id="notifyReopenBtn">
                <i class="fas fa-paper-plane me-1"></i>通知紀錄
            </button>
        }
    </div>
</div>

<!-- 處理完成後跳出的通知視窗：檢舉成立顯示「通知檢舉者」+「通知被檢舉會員」兩張卡片，駁回檢舉只顯示「通知檢舉者」一張卡片 -->
<div class="modal fade" id="notifyModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">檢舉通知</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <div class="modal-body">
                <div class="card mb-3">
                    <div class="card-header py-2 bg-primary">
                        <h6 class="m-0 fw-bold text-white">通知檢舉者內容</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">標題</label>
                            <input type="text" id="reporterTitle" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">內容</label>
                            <textarea id="reporterContent" class="form-control" rows="8"></textarea>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm" id="saveReporterNotify">儲存</button>
                        <span class="ms-2 text-success small d-none" id="reporterSavedMsg"><i class="fas fa-check me-1"></i>已送出</span>
                    </div>
                </div>

                <div class="card mb-3 d-none" id="reportedMemberNotifyCard">
                    <div class="card-header py-2 bg-info">
                        <h6 class="m-0 fw-bold text-white">通知被檢舉會員內容</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">標題</label>
                            <input type="text" id="reportedMemberTitle" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">內容</label>
                            <textarea id="reportedMemberContent" class="form-control" rows="8"></textarea>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm" id="saveReportedMemberNotify">儲存</button>
                        <span class="ms-2 text-success small d-none" id="reportedMemberSavedMsg"><i class="fas fa-check me-1"></i>已送出</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var reportId = @Model.ReportID;
            var notifyReporterUrl = '@Url.Action("NotifyReporter", "Reports", new { id = Model.ReportID })';
            var notifyReportedMemberUrl = '@Url.Action("NotifyReportedMember", "Reports", new { id = Model.ReportID })';
            var notifyModalElement = document.getElementById('notifyModal');
            var notifyModal = bootstrap.Modal.getOrCreateInstance(notifyModalElement);

            function antiForgeryToken() {
                return $('#handleForm input[name="__RequestVerificationToken"]').val();
            }

            function openNotifyModal(status, reporter, reportedMember) {
                $('#reporterTitle').val(reporter.title);
                $('#reporterContent').val(reporter.content);
                $('#reporterSavedMsg').addClass('d-none');

                if (status === 'Approved' && reportedMember) {
                    $('#reportedMemberNotifyCard').removeClass('d-none');
                    $('#reportedMemberTitle').val(reportedMember.title);
                    $('#reportedMemberContent').val(reportedMember.content);
                    $('#reportedMemberSavedMsg').addClass('d-none');
                } else {
                    $('#reportedMemberNotifyCard').addClass('d-none');
                }

                notifyModal.show();
            }

            // 送出處理改成 AJAX，成功後不整頁重新整理，直接跳出通知視窗
            $('#handleForm').on('submit', function (e) {
                e.preventDefault();
                var $form = $(this);
                var $btn = $form.find('button[type="submit"]').prop('disabled', true);

                $.ajax({
                    url: $form.attr('action'),
                    method: 'POST',
                    data: $form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                }).done(function (res) {
                    if (res.success) {
                        openNotifyModal(res.status, res.reporter, res.reportedMember);
                    }
                }).fail(function () {
                    alert('處理失敗，請重新整理頁面後再試一次');
                }).always(function () {
                    $btn.prop('disabled', false);
                });
            });

            // 已處理完畢的檢舉，重新開啟通知視窗（用目前的處理狀態＋預設範本重新帶入）
            $('#notifyReopenBtn').on('click', function () {
                openNotifyModal('@Model.Status',
                    { title: @Html.Raw(Json.Serialize(Model.DefaultNotificationTitle)), content: @Html.Raw(Json.Serialize(Model.DefaultNotificationContent)) },
                    { title: @Html.Raw(Json.Serialize(Model.DefaultReportedMemberNotificationTitle)), content: @Html.Raw(Json.Serialize(Model.DefaultReportedMemberNotificationContent)) }
                );
            });

            $('#saveReporterNotify').on('click', function () {
                var $btn = $(this).prop('disabled', true);
                $.ajax({
                    url: notifyReporterUrl,
                    method: 'POST',
                    data: {
                        __RequestVerificationToken: antiForgeryToken(),
                        Title: $('#reporterTitle').val(),
                        Content: $('#reporterContent').val()
                    },
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                }).done(function () {
                    $('#reporterSavedMsg').removeClass('d-none');
                }).fail(function () {
                    alert('通知檢舉者失敗');
                }).always(function () {
                    $btn.prop('disabled', false);
                });
            });

            $('#saveReportedMemberNotify').on('click', function () {
                var $btn = $(this).prop('disabled', true);
                $.ajax({
                    url: notifyReportedMemberUrl,
                    method: 'POST',
                    data: {
                        __RequestVerificationToken: antiForgeryToken(),
                        Title: $('#reportedMemberTitle').val(),
                        Content: $('#reportedMemberContent').val()
                    },
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                }).done(function () {
                    $('#reportedMemberSavedMsg').removeClass('d-none');
                }).fail(function () {
                    alert('通知被檢舉會員失敗');
                }).always(function () {
                    $btn.prop('disabled', false);
                });
            });

            // 關閉視窗後重新整理頁面，讓左側的處理狀態／處理時間等欄位同步最新結果
            notifyModalElement.addEventListener('hidden.bs.modal', function () {
                window.location.reload();
            });
        })();
    </script>
}
