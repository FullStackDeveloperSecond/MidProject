@model MidProject.Models.DTOs.ReportDto

@{
    ViewData["Title"] = "檢舉詳情";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">檢舉詳情 #@Model.ReportID</h1>
        <p class="text-muted mb-0">查看檢舉內容並完成管理員審核</p>
    </div>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent mb-0 p-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">HOME</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">檢舉管理</a></li>
            <li class="breadcrumb-item active">詳情</li>
        </ol>
    </nav>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="關閉"></button>
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <!-- 檢舉內容：欄位與 Index 列表頁一致（編號/處理狀態/檢舉目標/檢舉分類/檢舉者/被檢舉會員/檢舉日期/處理管理員），
             另外補充目標內容、檢舉原因、處理備註這幾項只有詳情頁才需要的細節 -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 fw-bold text-primary">檢舉內容</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">編號</dt>
                    <dd class="col-sm-9">@Model.ReportID</dd>

                    <dt class="col-sm-3">處理狀態</dt>
                    <dd class="col-sm-9">
                        @{
                            var badgeClass = Model.Status switch
                            {
                                "Pending" => "bg-warning text-dark",
                                "Approved" => "bg-success",
                                "Rejected" => "bg-secondary",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@Model.StatusDisplay</span>
                    </dd>

                    <dt class="col-sm-3">檢舉目標</dt>
                    <dd class="col-sm-9">
                        @{
                            var targetController = Model.RestaurantID.HasValue ? "Restaurants"
                                : Model.ReviewID.HasValue ? "Reviews"
                                : null;
                            var targetId = Model.RestaurantID ?? Model.ReviewID ?? Model.ImageID;
                        }
                        @if (Model.ReviewID.HasValue)
                        {
                            <!-- 檢舉目標為評論：「評論」兩字連結至該評論詳情頁 -->
                            <a asp-controller="Reviews" asp-action="Details" asp-route-id="@Model.ReviewID">@Model.TargetType</a>
                        }
                        else
                        {
                            @Model.TargetType
                        }
                        @if (Model.ImageID.HasValue)
                        {
                            <span class="text-muted">#@Model.ImageID</span>
                        }
                        @if (Model.RestaurantName != null)
                        {
                            @: （
                            @if (targetController != null)
                            {
                                <a asp-controller="@targetController" asp-action="Details" asp-route-id="@targetId">@Model.RestaurantName</a>
                            }
                            else
                            {
                                @Model.RestaurantName
                            }
                            @: ）
                        }
                    </dd>

                    <dt class="col-sm-3">檢舉分類</dt>
                    <dd class="col-sm-9">@Model.CategoryDisplay</dd>

                    <dt class="col-sm-3">檢舉者</dt>
                    <dd class="col-sm-9">
                        <a asp-controller="AdminMembers" asp-action="Edit" asp-route-id="@Model.ReporterMemberID">
                            @Model.ReporterUserName
                        </a>
                    </dd>

                    <dt class="col-sm-3">被檢舉會員</dt>
                    <dd class="col-sm-9">
                        @if (Model.ReportedMemberID.HasValue && Model.ReportedMemberUserName != null)
                        {
                            <a asp-controller="AdminMembers" asp-action="Edit" asp-route-id="@Model.ReportedMemberID">
                                @Model.ReportedMemberUserName
                            </a>
                        }
                        else
                        {
                            @(Model.ReportedMemberUserName ?? "—")
                        }
                    </dd>

                    <dt class="col-sm-3">檢舉日期</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-3">處理管理員</dt>
                    <dd class="col-sm-9">@(Model.HandledByUserName ?? "—")</dd>

                    <dt class="col-sm-3">檢舉原因</dt>
                    <dd class="col-sm-9">@Model.Reason</dd>

                    @if (Model.HandledAt != null)
                    {
                        <dt class="col-sm-3">處理時間</dt>
                        <dd class="col-sm-9">@Model.HandledAt?.ToString("yyyy-MM-dd HH:mm")</dd>

                        <dt class="col-sm-3">處理備註</dt>
                        <dd class="col-sm-9">@Model.AdminNote</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 fw-bold text-primary">處理檢舉</h6>
            </div>
            <div class="card-body">
                <form id="handleForm" asp-action="Handle" asp-route-id="@Model.ReportID" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">處理結果</label>
                        <select name="Status" class="form-select">
                            <option value="Approved">檢舉成立</option>
                            <option value="Rejected">駁回檢舉</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">檢舉分類（可修改）</label>
                        <select name="Category" class="form-select">
                            @foreach (var cat in new[] { "不實資訊", "廣告洗版", "人身攻擊", "仇恨言論", "色情內容", "垃圾訊息" })
                            {
                                @if (cat == Model.Category)
                                {
                                    <option value="@cat" selected>@cat</option>
                                }
                                else
                                {
                                    <option value="@cat">@cat</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">管理員備註</label>
                        <textarea name="AdminNote" class="form-control" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check"></i> 送出處理
                    </button>
                </form>
            </div>
        </div>

        @if (Model.Status != "Pending")
        {
            <!-- 只有已經審核完畢（核准/駁回）的檢舉才能通知檢舉會員審核結果，按下後開啟下方的通知視窗 -->
            <button type="button" class="btn btn-outline-primary w-100 mb-4" id="notifyReopenBtn">
                <i class="fas fa-paper-plane me-1"></i>通知紀錄
            </button>
        }
    </div>
</div>

<!-- 處理完成後跳出的通知視窗：檢舉成立顯示「通知檢舉者」+「通知被檢舉會員」兩張卡片，駁回檢舉只顯示「通知檢舉者」一張卡片 -->
<div class="modal fade" id="notifyModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">檢舉通知</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <div class="modal-body">
                <div class="card mb-3">
                    <div class="card-header py-2 bg-primary">
                        <h6 class="m-0 fw-bold text-white">通知檢舉者內容</h6>
                    </div>
                    <div class="card-body">
                        <!-- 通知紀錄：查得到已送出紀錄時顯示提示與送出時間 -->
                        <div class="text-muted small mb-2 d-none" id="reporterSentInfo"></div>
                        <div class="mb-3">
                            <label class="form-label">標題</label>
                            <input type="text" id="reporterTitle" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">內容</label>
                            <textarea id="reporterContent" class="form-control" rows="8"></textarea>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm" id="saveReporterNotify">儲存</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm ms-1" id="editReporterNotify">編輯</button>
                        <span class="ms-2 text-success small d-none" id="reporterSavedMsg"><i class="fas fa-check me-1"></i>已送出</span>
                    </div>
                </div>

                <div class="card mb-3 d-none" id="reportedMemberNotifyCard">
                    <div class="card-header py-2 bg-info">
                        <h6 class="m-0 fw-bold text-white">通知被檢舉會員內容</h6>
                    </div>
                    <div class="card-body">
                        <!-- 通知紀錄：查得到已送出紀錄時顯示提示與送出時間 -->
                        <div class="text-muted small mb-2 d-none" id="reportedMemberSentInfo"></div>
                        <div class="mb-3">
                            <label class="form-label">標題</label>
                            <input type="text" id="reportedMemberTitle" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">內容</label>
                            <textarea id="reportedMemberContent" class="form-control" rows="8"></textarea>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm" id="saveReportedMemberNotify">儲存</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm ms-1" id="editReportedMemberNotify">編輯</button>
                        <span class="ms-2 text-success small d-none" id="reportedMemberSavedMsg"><i class="fas fa-check me-1"></i>已送出</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var reportId = @Model.ReportID;
            // 此檢舉開頁時是否為「待處理」：待處理案件剛送出處理後，通知視窗的「儲存」直接開放，不套用編輯鎖定
            var isPendingReport = @(Model.Status == "Pending" ? "true" : "false");
            var notifyReporterUrl = '@Url.Action("NotifyReporter", "Reports", new { id = Model.ReportID })';
            var notifyReportedMemberUrl = '@Url.Action("NotifyReportedMember", "Reports", new { id = Model.ReportID })';
            var sentNotificationsUrl = '@Url.Action("SentNotifications", "Reports", new { id = Model.ReportID })';
            var notifyModalElement = document.getElementById('notifyModal');
            var notifyModal = bootstrap.Modal.getOrCreateInstance(notifyModalElement);

            function antiForgeryToken() {
                return $('#handleForm input[name="__RequestVerificationToken"]').val();
            }

            // 每張通知卡片的「編輯／儲存」狀態控制：
            // 已處理案件重開通知紀錄時欄位鎖定、「儲存」停用，必須先按「編輯」解鎖欄位，
            // 且實際改動過標題或內容後，「儲存」才會啟用；待處理案件剛送出處理則直接開放儲存。
            function createEditableCard(opts) {
                var $title = $('#' + opts.titleId);
                var $content = $('#' + opts.contentId);
                var $editBtn = $('#' + opts.editBtnId);
                var $saveBtn = $('#' + opts.saveBtnId);
                var baselineTitle = '';
                var baselineContent = '';
                var editMode = false;
                var gated = true;

                function refreshSaveState() {
                    // 未 gated（待處理案件剛送出處理）：「儲存」一律可用，不需先按「編輯」
                    if (!gated) {
                        $saveBtn.prop('disabled', false);
                        return;
                    }
                    var changed = $title.val() !== baselineTitle || $content.val() !== baselineContent;
                    $saveBtn.prop('disabled', !(editMode && changed));
                }

                // 鎖定（已處理案件的通知紀錄）：欄位唯讀、「儲存」停用、「編輯」可用
                function lock() {
                    gated = true;
                    editMode = false;
                    baselineTitle = $title.val();
                    baselineContent = $content.val();
                    $title.prop('readonly', true);
                    $content.prop('readonly', true);
                    $editBtn.prop('disabled', false);
                    $saveBtn.prop('disabled', true);
                }

                // 直接開放（待處理案件剛送出處理）：欄位可編輯、「儲存」直接可用
                function openFree() {
                    gated = false;
                    editMode = true;
                    baselineTitle = $title.val();
                    baselineContent = $content.val();
                    $title.prop('readonly', false);
                    $content.prop('readonly', false);
                    $editBtn.prop('disabled', true);
                    $saveBtn.prop('disabled', false);
                }

                $editBtn.on('click', function () {
                    editMode = true;
                    $title.prop('readonly', false);
                    $content.prop('readonly', false);
                    $editBtn.prop('disabled', true);
                    $content.trigger('focus');
                    refreshSaveState();
                });

                $title.on('input', refreshSaveState);
                $content.on('input', refreshSaveState);

                return { lock: lock, openFree: openFree };
            }

            var reporterCard = createEditableCard({
                titleId: 'reporterTitle', contentId: 'reporterContent',
                editBtnId: 'editReporterNotify', saveBtnId: 'saveReporterNotify'
            });
            var reportedMemberCard = createEditableCard({
                titleId: 'reportedMemberTitle', contentId: 'reportedMemberContent',
                editBtnId: 'editReportedMemberNotify', saveBtnId: 'saveReportedMemberNotify'
            });

            function openNotifyModal(status, reporter, reportedMember, gated) {
                // gated === false（待處理案件剛送出處理）→ 直接開放儲存；否則套用編輯鎖定
                var applyState = function (card) { if (gated === false) { card.openFree(); } else { card.lock(); } };

                $('#reporterTitle').val(reporter.title);
                $('#reporterContent').val(reporter.content);
                $('#reporterSavedMsg').addClass('d-none');
                $('#reporterSentInfo').addClass('d-none');
                applyState(reporterCard);

                if (status === 'Approved' && reportedMember) {
                    $('#reportedMemberNotifyCard').removeClass('d-none');
                    $('#reportedMemberTitle').val(reportedMember.title);
                    $('#reportedMemberContent').val(reportedMember.content);
                    $('#reportedMemberSavedMsg').addClass('d-none');
                    $('#reportedMemberSentInfo').addClass('d-none');
                    applyState(reportedMemberCard);
                } else {
                    $('#reportedMemberNotifyCard').addClass('d-none');
                }

                notifyModal.show();
            }

            // 送出處理改成 AJAX，成功後不整頁重新整理，直接跳出通知視窗
            $('#handleForm').on('submit', function (e) {
                e.preventDefault();
                var $form = $(this);
                var $btn = $form.find('button[type="submit"]').prop('disabled', true);

                $.ajax({
                    url: $form.attr('action'),
                    method: 'POST',
                    data: $form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                }).done(function (res) {
                    if (res.success) {
                        // 原本是待處理的案件剛送出處理 → 直接開放儲存（gated=false）；重新處理已處理案件則維持鎖定
                        openNotifyModal(res.status, res.reporter, res.reportedMember, !isPendingReport);
                    }
                }).fail(function () {
                    alert('處理失敗，請重新整理頁面後再試一次');
                }).always(function () {
                    $btn.prop('disabled', false);
                });
            });

            var defaultReporterNotify = { title: @Html.Raw(Json.Serialize(Model.DefaultNotificationTitle)), content: @Html.Raw(Json.Serialize(Model.DefaultNotificationContent)) };
            var defaultReportedMemberNotify = { title: @Html.Raw(Json.Serialize(Model.DefaultReportedMemberNotificationTitle)), content: @Html.Raw(Json.Serialize(Model.DefaultReportedMemberNotificationContent)) };

            var reporterMemberId = @Model.ReporterMemberID;
            var reportedMemberId = @(Model.ReportedMemberID?.ToString() ?? "null");

            function showSentInfo(selector, record) {
                if (!record) return; // openNotifyModal 開啟時已預設隱藏
                var sentAtText = record.sentAt ? record.sentAt.replace('T', ' ').substring(0, 16) : '';
                $(selector).removeClass('d-none')
                    .text('以下為已送出的通知內容' + (sentAtText ? '（送出時間：' + sentAtText + '）' : ''));
            }

            // 已處理完畢的檢舉，開啟「通知紀錄」視窗：
            // 先查詢該檢舉已送出的通知（Notifications.SourceReportID 關聯，索引已非唯一、兩張卡片的通知都會掛標記），
            // 依收件會員把紀錄對應到「通知檢舉者」/「通知被檢舉會員」卡片；查不到的卡片才退回預設範本
            $('#notifyReopenBtn').on('click', function () {
                $.ajax({
                    url: sentNotificationsUrl,
                    method: 'GET'
                }).done(function (res) {
                    var records = (res.success && res.records) ? res.records : [];

                    // 依收件會員挑紀錄：優先取與目前處理結果相符的，否則取最新一筆（後端已依新到舊排序）
                    function pick(memberId) {
                        if (memberId === null) return null;
                        var mine = records.filter(function (r) { return r.memberID === memberId; });
                        if (mine.length === 0) return null;
                        return mine.find(function (r) { return r.outcome === '@Model.Status'; }) || mine[0];
                    }

                    var reporterRecord = pick(reporterMemberId);
                    var reportedRecord = pick(reportedMemberId);

                    // 自我檢舉（檢舉者＝被檢舉會員）時兩張卡片會對到同一批紀錄，改用預設標題前綴輔助區分
                    if (reporterMemberId === reportedMemberId && records.length > 0) {
                        reporterRecord = records.find(function (r) { return r.memberID === reporterMemberId && r.title.indexOf('【檢舉結果通知】') === 0; }) || reporterRecord;
                        reportedRecord = records.find(function (r) { return r.memberID === reportedMemberId && r.title.indexOf('【內容審核通知】') === 0; }) || null;
                    }

                    openNotifyModal('@Model.Status',
                        reporterRecord ? { title: reporterRecord.title, content: reporterRecord.content } : defaultReporterNotify,
                        reportedRecord ? { title: reportedRecord.title, content: reportedRecord.content } : defaultReportedMemberNotify);

                    showSentInfo('#reporterSentInfo', reporterRecord);
                    showSentInfo('#reportedMemberSentInfo', reportedRecord);
                }).fail(function () {
                    // 查詢失敗時退回預設範本，不阻擋操作
                    openNotifyModal('@Model.Status', defaultReporterNotify, defaultReportedMemberNotify);
                });
            });

            $('#saveReporterNotify').on('click', function () {
                var $btn = $(this).prop('disabled', true);
                $.ajax({
                    url: notifyReporterUrl,
                    method: 'POST',
                    data: {
                        __RequestVerificationToken: antiForgeryToken(),
                        Title: $('#reporterTitle').val(),
                        Content: $('#reporterContent').val()
                    },
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                }).done(function () {
                    $('#reporterSavedMsg').removeClass('d-none');
                    // 送出後重新鎖定，須再按「編輯」並改動內容才能再次送出
                    reporterCard.lock();
                }).fail(function () {
                    alert('通知檢舉者失敗');
                    $btn.prop('disabled', false);
                });
            });

            $('#saveReportedMemberNotify').on('click', function () {
                var $btn = $(this).prop('disabled', true);
                $.ajax({
                    url: notifyReportedMemberUrl,
                    method: 'POST',
                    data: {
                        __RequestVerificationToken: antiForgeryToken(),
                        Title: $('#reportedMemberTitle').val(),
                        Content: $('#reportedMemberContent').val()
                    },
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                }).done(function () {
                    $('#reportedMemberSavedMsg').removeClass('d-none');
                    // 送出後重新鎖定，須再按「編輯」並改動內容才能再次送出
                    reportedMemberCard.lock();
                }).fail(function () {
                    alert('通知被檢舉會員失敗');
                    $btn.prop('disabled', false);
                });
            });

            // 關閉視窗後重新整理頁面，讓左側的處理狀態／處理時間等欄位同步最新結果
            notifyModalElement.addEventListener('hidden.bs.modal', function () {
                window.location.reload();
            });
        })();
    </script>
}
