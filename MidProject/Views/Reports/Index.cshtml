@using Microsoft.AspNetCore.Mvc.Rendering
@model MidProject.Models.DTOs.PagedResult<MidProject.Models.DTOs.ReportDto>

@section Styles {
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared-pagination.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "檢舉查詢";

    // 先在程式碼區塊把下拉選單選項算好存成變數，
    // 避免直接把含雙引號字串的 C# 運算式寫進 HTML 屬性裡（會被 Razor 誤判屬性提前結束）
    var statusOptions = new SelectList(new List<SelectListItem>
    {
        new SelectListItem("待處理", "Pending"),
        new SelectListItem("檢舉成立", "Approved"),
        new SelectListItem("駁回檢舉", "Rejected"),
    }, "Value", "Text", ViewBag.CurrentStatus as string);

    // 檢舉目標不包含會員（Member），下拉選單顯示中文，送出的值維持英文
    var targetTypeOptions = new SelectList(new List<SelectListItem>
    {
        new SelectListItem("餐廳", "Restaurant"),
        new SelectListItem("評論", "Review"),
        new SelectListItem("圖片", "Image"),
    }, "Value", "Text", ViewBag.CurrentTargetType as string);

    var categoryOptions = new SelectList(new List<string> { "不實資訊", "廣告洗版", "人身攻擊", "仇恨言論", "色情內容", "垃圾訊息" }, ViewBag.CurrentCategory as string);

    // 組出換頁連結，保留目前的搜尋條件，只換 Page 參數
    string PageUrl(int page)
    {
        var q = Context.Request.Query;
        var parts = new List<string>();
        foreach (var key in new[] { "RestaurantID", "ReviewID", "Keyword", "Status", "TargetType", "Category", "DateFrom", "DateTo", "SortBy", "SortDirection" })
        {
            var value = q[key].ToString();
            if (!string.IsNullOrEmpty(value))
                parts.Add($"{key}={Uri.EscapeDataString(value)}");
        }
        parts.Add($"Page={page}");
        return "?" + string.Join("&", parts);
    }

    // 組出排序連結：點同一欄位會切換 asc/desc，點別的欄位預設從 desc 開始
    var currentSortBy = ViewBag.CurrentSortBy as string ?? "CreatedAt";
    var currentSortDirection = ViewBag.CurrentSortDirection as string ?? "desc";

    string SortUrl(string column)
    {
        var nextDirection = (currentSortBy == column && currentSortDirection == "desc") ? "asc" : "desc";

        var q = Context.Request.Query;
        var parts = new List<string>();
        foreach (var key in new[] { "RestaurantID", "ReviewID", "Keyword", "Status", "TargetType", "Category", "DateFrom", "DateTo" })
        {
            var value = q[key].ToString();
            if (!string.IsNullOrEmpty(value))
                parts.Add($"{key}={Uri.EscapeDataString(value)}");
        }
        parts.Add($"SortBy={column}");
        parts.Add($"SortDirection={nextDirection}");
        parts.Add("Page=1");
        return "?" + string.Join("&", parts);
    }

    // 排序箭頭圖示：目前排序中的欄位顯示對應方向的實心箭頭，其餘欄位顯示淡色的雙向箭頭
    string SortIcon(string column)
    {
        if (currentSortBy != column) return "fas fa-sort text-muted";
        return currentSortDirection == "asc" ? "fas fa-sort-up" : "fas fa-sort-down";
    }
}

<a class="btn btn-outline-secondary js-back-btn-conditional d-none mb-2" data-referrer-pattern="/Restaurants/Details" href="#">← 返回</a>
<a class="btn btn-outline-secondary js-back-btn-conditional d-none mb-2" data-referrer-pattern="/Reports/Dashboard" href="#">← 返回</a>

<div class="ds-page-header d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div>
        <h1 class="ds-h2 mb-1">檢舉查詢</h1>
        <p class="mb-0">查詢並處理會員提交的檢舉案件</p>
    </div>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent mb-0 p-0">
            <li class="breadcrumb-item"><a asp-action="Dashboard">檢舉統計</a></li>
            <li class="breadcrumb-item active">檢舉查詢</li>
        </ol>
    </nav>
</div>

<!-- 搜尋條件工具列 -->
<div class="ds-toolbar">
    <h6 class="ds-block-label">篩選條件</h6>
    <div>
        <form method="get" id="reportFilterForm">
            @if (Context.Request.Query.ContainsKey("RestaurantID"))
            {
                <input type="hidden" name="RestaurantID" value="@Context.Request.Query["RestaurantID"]" />
            }
            @if (Context.Request.Query.ContainsKey("ReviewID"))
            {
                <input type="hidden" name="ReviewID" value="@Context.Request.Query["ReviewID"]" />
            }
            <div class="ds-filter-row">
                <div class="ds-filter-search-group">
                    <div class="ds-filter-field">
                        <label>關鍵字</label>
                        <input type="text" name="Keyword" value="@Context.Request.Query["Keyword"]" class="form-control ds-search-input-fill" placeholder="輸入關鍵字" />
                    </div>
                    <div class="ds-filter-actions">
                        <button type="submit" class="btn ds-btn-query">
                            <i class="fas fa-search"></i> 查詢
                        </button>
                        <a asp-action="Index" class="btn ds-btn-clear">清除</a>
                    </div>
                </div>
                <div class="ds-filter-field">
                    <label>處理狀態</label>
                    <select name="Status" class="form-select" asp-items="statusOptions" onchange="this.form.requestSubmit()">
                        <option value="">全部</option>
                    </select>
                </div>
                <div class="ds-filter-field">
                    <label>檢舉目標</label>
                    <select name="TargetType" class="form-select" asp-items="targetTypeOptions" onchange="this.form.requestSubmit()">
                        <option value="">全部</option>
                    </select>
                </div>
                <div class="ds-filter-field">
                    <label>檢舉分類</label>
                    <select name="Category" class="form-select" asp-items="categoryOptions" onchange="this.form.requestSubmit()">
                        <option value="">全部</option>
                    </select>
                </div>
                <div class="ds-filter-field">
                    <label for="reportDateFrom">檢舉日期（從）</label>
                    <input type="date" id="reportDateFrom" name="DateFrom" value="@Context.Request.Query["DateFrom"]" class="form-control" />
                </div>
                <div class="ds-filter-field">
                    <label for="reportDateTo">檢舉日期（至）</label>
                    <input type="date" id="reportDateTo" name="DateTo" value="@Context.Request.Query["DateTo"]" class="form-control" />
                </div>
            </div>
            <div id="reportDateRangeError" class="text-danger small mt-2" role="alert" aria-live="polite"></div>
        </form>
    </div>
</div>

<!-- 列表 -->
<div class="ds-block-title-row">
    <h6>檢舉列表</h6>
    <span class="ds-muted small">共 @Model.TotalCount 筆</span>
</div>
<div class="ds-table-wrap mb-4">
        <div class="table-responsive">
            <table class="ds-table mb-0">
                <thead>
                    <tr>
                        <th style="width:70px;">
                            <a href="@SortUrl("ReportID")" class="text-dark text-decoration-none">
                                ID <i class="@SortIcon("ReportID")"></i>
                            </a>
                        </th>
                        <th>
                            <a href="@SortUrl("Status")" class="text-dark text-decoration-none">
                                處理狀態 <i class="@SortIcon("Status")"></i>
                            </a>
                        </th>
                        <th>檢舉目標</th>
                        <th>檢舉分類</th>
                        <th>檢舉者</th>
                        <th>被檢舉會員</th>
                        <th>
                            <a href="@SortUrl("CreatedAt")" class="text-dark text-decoration-none">
                                檢舉日期 <i class="@SortIcon("CreatedAt")"></i>
                            </a>
                        </th>
                        <th>
                            <a href="@SortUrl("ProcessingDays")" class="text-dark text-decoration-none">
                                處理天數 <i class="@SortIcon("ProcessingDays")"></i>
                            </a>
                        </th>
                        <th>處理管理員</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Model.Items)
                    {
                        <tr>
                            <td>@report.ReportID</td>
                            <td>
                                @{
                                    var badgeClass = report.Status switch
                                    {
                                        "Pending" => "ds-badge-warning",
                                        "Approved" => "ds-badge-success",
                                        "Rejected" => "ds-badge-gray",
                                        _ => "ds-badge-gray"
                                    };
                                }
                                <span class="ds-badge @badgeClass">@report.StatusDisplay</span>
                            </td>
                            <td>@report.TargetType</td>
                            <td>@report.CategoryDisplay</td>
                            <td>
                                <a asp-controller="AdminMembers" asp-action="Edit" asp-route-id="@report.ReporterMemberID">
                                    @report.ReporterUserName
                                </a>
                            </td>
                            <td>
                                @if (report.ReportedMemberID.HasValue && report.ReportedMemberUserName != null)
                                {
                                    <a asp-controller="AdminMembers" asp-action="Edit" asp-route-id="@report.ReportedMemberID">
                                        @report.ReportedMemberUserName
                                    </a>
                                }
                                else
                                {
                                    @(report.ReportedMemberUserName ?? "—")
                                }
                            </td>
                            <td>@report.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>@report.ProcessingDays</td>
                            <td>@(report.HandledByUserName ?? "—")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@report.ReportID" class="ds-icon-btn ds-icon-btn-view" title="查看" aria-label="查看">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted">沒有符合條件的資料</td></tr>
                    }
                </tbody>
            </table>
        </div>
</div>

@if (Model.TotalCount > 0)
{
    var showStart = (Model.Page - 1) * Model.PageSize + 1;
    var showEnd = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
    <div class="sp-pagination">
        <div class="sp-summary">目前顯示 @showStart–@showEnd 筆，共 @Model.TotalCount 筆</div>
        <nav aria-label="分頁導覽">
            <ul class="pagination">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@PageUrl(Model.Page - 1)">上一頁</a>
                </li>
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" href="@PageUrl(p)">@p</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@PageUrl(Model.Page + 1)">下一頁</a>
                </li>
            </ul>
        </nav>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('reportFilterForm');
            var dateFrom = document.getElementById('reportDateFrom');
            var dateTo = document.getElementById('reportDateTo');
            var error = document.getElementById('reportDateRangeError');

            function syncDateRange() {
                dateFrom.max = dateTo.value || '';
                dateTo.min = dateFrom.value || '';

                var invalid = dateFrom.value && dateTo.value && dateFrom.value > dateTo.value;
                dateFrom.setCustomValidity(invalid ? '開始日期不可晚於結束日期' : '');
                dateTo.setCustomValidity(invalid ? '結束日期不可早於開始日期' : '');
                error.textContent = invalid
                    ? '開始日期不可晚於結束日期，結束日期也不可早於開始日期。'
                    : '';
                return !invalid;
            }

            dateFrom.addEventListener('input', syncDateRange);
            dateTo.addEventListener('input', syncDateRange);
            form.addEventListener('submit', function (event) {
                if (!syncDateRange()) {
                    event.preventDefault();
                    form.reportValidity();
                }
            });
            syncDateRange();
        });
    </script>
}
