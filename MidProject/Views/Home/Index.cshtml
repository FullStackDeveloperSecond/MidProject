@model MidProject.Models.ViewModels.Dashboard.DashboardIndexViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Dashboard</h1>
        <p class="text-muted mb-0">快速掌握美食地圖後台目前的資料與待處理項目</p>
    </div>
</div>

<div class="row g-4">
    @foreach (var card in Model.Cards)
    {
        <div class="col-12 col-md-6 col-xl">
            @if (card.IsAvailable)
            {
                <a class="dashboard-card card h-100 text-decoration-none text-reset shadow-sm"
                   href="@card.TargetUrl">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="text-uppercase small fw-bold text-@card.AccentClass">@card.Title</div>
                            <span class="dashboard-card-icon bg-@card.AccentClass bg-opacity-10 text-@card.AccentClass"><i class="@card.IconClass"></i></span>
                        </div>
                        <div class="display-6 fw-bold mb-1">@card.Count</div>
                        <div class="text-muted small">@card.Description</div>
                    </div>
                </a>
            }
            else
            {
                <div class="dashboard-card card h-100 shadow-sm bg-light">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="text-uppercase small fw-bold text-secondary">@card.Title</div>
                            <span class="dashboard-card-icon bg-secondary bg-opacity-10 text-secondary"><i class="@card.IconClass"></i></span>
                        </div>
                        <div class="display-6 fw-bold text-secondary mb-1">—</div>
                        <div class="text-muted small">@card.Description</div>
                        @if (!string.IsNullOrWhiteSpace(card.UnavailableReason))
                        {
                            <div class="small text-secondary mt-2">@card.UnavailableReason</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
