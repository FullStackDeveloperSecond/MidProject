@model MidProject.Models.ViewModels.Dashboard.DashboardIndexViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="ds-h1 mb-0">Dashboard</h1>
        <p class="ds-welcome mb-0">歡迎回來，Admin。今天共有 @Model.PendingReportCount 筆待處理檢舉案件</p>
    </div>
</div>

<div class="row g-4">
    @foreach (var card in Model.Cards)
    {
        <div class="col-12 col-md-6 col-xl">
            @if (card.IsAvailable)
            {
                <a class="ds-stat-card text-decoration-none text-reset d-block h-100" href="@card.TargetUrl">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="ds-stat-label ds-accent-@card.AccentClass">@card.Title</div>
                        <span class="ds-stat-icon ds-icon-@card.AccentClass"><i class="@card.IconClass"></i></span>
                    </div>
                    <div class="ds-stat-value">@card.Count</div>
                    <div class="ds-stat-caption">@card.Description</div>
                    @if (!string.IsNullOrWhiteSpace(card.Trend))
                    {
                        <div class="ds-stat-trend ds-accent-@card.AccentClass">@card.Trend</div>
                    }
                </a>
            }
            else
            {
                <div class="ds-stat-card h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="ds-stat-label ds-muted">@card.Title</div>
                        <span class="ds-stat-icon ds-icon-gray"><i class="@card.IconClass"></i></span>
                    </div>
                    <div class="ds-stat-value ds-muted">—</div>
                    <div class="ds-stat-caption">@card.Description</div>
                    @if (!string.IsNullOrWhiteSpace(card.UnavailableReason))
                    {
                        <div class="ds-stat-caption ds-muted mt-1">@card.UnavailableReason</div>
                    }
                </div>
            }
        </div>
    }
</div>
