@model MidProject.Models.ViewModels.Dashboard.DashboardIndexViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Dashboard</h1>
        <p class="text-muted mb-0">快速掌握美食地圖後台目前的資料與待處理項目</p>
    </div>
</div>

<div class="row g-4">
    @foreach (var card in Model.Cards)
    {
        <div class="col-12 col-md-6 col-xl">
            @if (card.IsAvailable)
            {
                <a class="dashboard-card card h-100 text-decoration-none text-reset border-start border-4 border-@card.AccentClass"
                   asp-controller="Dashboard" asp-action="Details" asp-route-type="@card.Type">
                    <div class="card-body d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <div class="text-uppercase small fw-semibold text-@card.AccentClass mb-2">@card.Title</div>
                            <div class="display-6 fw-bold mb-2">@card.Count</div>
                            <div class="text-muted small">@card.Description</div>
                        </div>
                        <span class="dashboard-card-icon text-@card.AccentClass"><i class="@card.IconClass"></i></span>
                    </div>
                </a>
            }
            else
            {
                <div class="card h-100 border-start border-4 border-secondary bg-light">
                    <div class="card-body d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <div class="text-uppercase small fw-semibold text-secondary mb-2">@card.Title</div>
                            <div class="display-6 fw-bold text-secondary mb-2">—</div>
                            <div class="text-muted small">@card.Description</div>
                            @if (!string.IsNullOrWhiteSpace(card.UnavailableReason))
                            {
                                <div class="small text-secondary mt-2">@card.UnavailableReason</div>
                            }
                        </div>
                        <span class="dashboard-card-icon text-secondary"><i class="@card.IconClass"></i></span>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="card mt-4">
    <div class="card-header">
        <h2 class="h5 mb-0">Demo 操作提示</h2>
    </div>
    <div class="card-body">
        <p class="mb-0 text-muted">點擊可用的統計卡片查看前 10 筆資料，再由通用明細頁前往完整模組列表。</p>
    </div>
</div>
