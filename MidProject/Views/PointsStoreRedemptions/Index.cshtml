@model MidProject.Models.ViewModels.PointsStore.RedemptionsIndexViewModel
@{
    ViewData["Title"] = "點數商城兌換紀錄";
}

@section Styles {
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared-pagination.css" asp-append-version="true" />
}

<div class="ds-page-header">
    <h1 class="ds-h2 mb-1">點數商城兌換紀錄</h1>
    <p>會員以點數兌換頭像外框的完整流水紀錄，可依會員、商品與時間區間查詢。</p>
</div>

<div class="row mb-3 g-3">
    <div class="col-md-3">
        <div class="ds-stat-card ds-stat-card-sm h-100">
            <div class="ds-stat-label ds-accent-warning">本月兌換次數</div>
            <div class="ds-stat-value">@Model.MonthlyRedemptionCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ds-stat-card ds-stat-card-sm h-100">
            <div class="ds-stat-label ds-accent-danger">本月消耗點數</div>
            <div class="ds-stat-value">@Model.MonthlyPointsSpent.ToString("N0")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ds-stat-card ds-stat-card-sm h-100">
            <div class="ds-stat-label ds-accent-purple">最熱銷商品</div>
            <div class="ds-stat-value" style="font-size:24px;">@(Model.TopFrameName ?? "—")</div>
            <div class="ds-stat-caption">本月 @Model.TopFrameCount 次兌換</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ds-stat-card ds-stat-card-sm h-100">
            <div class="ds-stat-label ds-accent-primary">兌換會員數</div>
            <div class="ds-stat-value">@Model.DistinctMemberCount</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.DateRangeError))
{
    <div class="alert alert-danger">@Model.DateRangeError</div>
}

<form method="get" class="ds-toolbar">
    <h6 class="ds-block-label">篩選條件</h6>
    <div class="ds-filter-row">
        <div class="ds-filter-search-group">
            <div class="ds-filter-field"><label for="keyword">會員關鍵字</label><input id="keyword" type="text" name="keyword" class="form-control ds-search-input-fill" value="@Model.Keyword" placeholder="搜尋會員帳號或名稱" /></div>
            <div class="ds-filter-actions"><button type="submit" class="btn ds-btn-query"><i class="fas fa-search"></i>查詢</button><a asp-action="Index" class="btn ds-btn-clear">清除</a></div>
        </div>
    <div class="ds-filter-field">
        <label for="frameFilter">商品</label>
        <select id="frameFilter" name="frameFilter" class="form-select">
            <option value="">所有商品</option>
            @foreach (var f in Model.AvailableFrames)
            {
                <option value="@f.FrameID" selected="@(Model.FrameFilter == f.FrameID)">@f.Name</option>
            }
        </select>
    </div>
    <div class="ds-filter-field">
        <label for="startDate">起始日期</label>
        <input id="startDate" type="date" name="startDate" class="form-control" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="ds-filter-field">
        <label for="endDate">結束日期</label>
        <input id="endDate" type="date" name="endDate" class="form-control" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
    </div>
    </div>
</form>

<div class="ds-block-title-row"><h6>兌換紀錄列表</h6><span class="ds-muted small">共 @Model.TotalItems 筆</span></div>
<div class="ds-table-wrap">
    <div class="table-responsive">
        <table class="ds-table mb-0">
    <thead>
        <tr>
            <th>兌換時間</th>
            <th>會員</th>
            <th>商品</th>
            <th>扣除點數</th>
            <th>兌換後餘額</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Redemptions)
        {
            <tr>
                <td>@r.RedeemedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(r.MemberAvatarUrl))
                        {
                            <img src="@r.MemberAvatarUrl" width="28" height="28" class="rounded-circle" />
                        }
                        <span>@r.MemberName</span>
                    </div>
                </td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(r.FrameImageUrl))
                        {
                            <img src="@r.FrameImageUrl" width="28" height="28" class="rounded-circle" />
                        }
                        <span>@r.FrameName</span>
                    </div>
                </td>
                <td class="text-danger">-@r.PointsSpent.ToString("N0")</td>
                <td>@r.BalanceAfter.ToString("N0")</td>
            </tr>
        }
        @if (!Model.Redemptions.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">目前沒有符合條件的兌換紀錄。</td>
            </tr>
        }
    </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    var showStart = (Model.CurrentPage - 1) * 20 + 1;
    var showEnd = Math.Min(Model.CurrentPage * 20, Model.TotalItems);
    <div class="sp-pagination">
        <div class="sp-summary">目前顯示 @showStart–@showEnd 筆，共 @Model.TotalItems 筆</div>
        <nav aria-label="兌換紀錄分頁">
            <ul class="pagination">
                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Math.Max(1, Model.CurrentPage - 1), keyword = Model.Keyword, frameFilter = Model.FrameFilter, startDate = Model.StartDate, endDate = Model.EndDate })">上一頁</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")"><a class="page-link" href="@Url.Action("Index", new { page = i, keyword = Model.Keyword, frameFilter = Model.FrameFilter, startDate = Model.StartDate, endDate = Model.EndDate })">@i</a></li>
                }
                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Math.Min(Model.TotalPages, Model.CurrentPage + 1), keyword = Model.Keyword, frameFilter = Model.FrameFilter, startDate = Model.StartDate, endDate = Model.EndDate })">下一頁</a>
                </li>
            </ul>
        </nav>
    </div>
}
